---
import CloudMotif from './CloudMotif.astro';
import { ELEMENTS, SPIRITS, TOOLS } from '../data/mugu-options.js';
---

<div class="chapter-rule" aria-hidden="true"><span>巫</span></div>
<section class="chapter mugu" id="sec-mugu" aria-labelledby="mugu-title">
	<header class="chapter-heading">
		<div class="chapter-title-row">
			<h2 id="mugu-title" class="book-chapter-title"><span lang="zh-Hant">巫具支給</span><small>무구 지급</small></h2>
			<div class="chapter-cloud"><CloudMotif /></div>
		</div>
		<p class="chapter-intro">신입 퇴마사에게는 업무용 무구 1점을 지급합니다. 아래 신청서를 작성하여 제출하시면, 대표실 검토 후 적합한 무구를 <span class="mugu-closing-phrase">배정해 드립니다.</span></p>
	</header>

	<form class="mugu-sheet" id="mugu-form" novalidate>
		<div class="mugu-document-meta"><span>무탈 · 총무 서식 제01호</span><span>사내 비품 / 신입 지급용</span></div>
		<div class="mugu-sheet-head">
			<div>
				<p class="mugu-sheet-kicker">주식회사 무탈 · 대표실</p>
				<h3>무구 지급 신청서</h3>
			</div>
			<div class="mugu-approval" aria-label="결재란">
				<span class="mugu-approval-label">결재</span>
				<div><span>담당</span><strong>접수</strong></div>
				<div><span>대표</span><strong class="mugu-approval-seal">검토</strong></div>
			</div>
		</div>

		<div class="mugu-fields">
			<div class="mugu-field">
				<label class="mugu-label" for="mugu-spirit">모시는 신</label>
				<div class="mugu-control mugu-select">
					<select id="mugu-spirit" name="spirit" aria-describedby="mugu-spirit-hint">
						<option value="random" selected>랜덤</option>
						{SPIRITS.map((item) => <option value={item.id}>{item.name}{item.hanja ? `(${item.hanja})` : ''}</option>)}
					</select>
				</div>
				<p class="mugu-hint" id="mugu-spirit-hint"></p>
			</div>

			<div class="mugu-field">
				<label class="mugu-label" for="mugu-element">기운</label>
				<div class="mugu-control mugu-select">
					<select id="mugu-element" name="element" aria-describedby="mugu-element-hint">
						<option value="random" selected>랜덤</option>
						{ELEMENTS.map((item) => <option value={item.id}>{item.name}({item.hanja}) · {item.trait}</option>)}
					</select>
				</div>
				<p class="mugu-hint" id="mugu-element-hint" aria-live="polite"></p>
			</div>

			<div class="mugu-field">
				<label class="mugu-label" for="mugu-tool">무구</label>
				<div class="mugu-control mugu-select">
					<select id="mugu-tool" name="tool" aria-describedby="mugu-tool-hint">
						<option value="random" selected>랜덤</option>
						{TOOLS.map((item) => <option value={item.id}>{item.label || item.name}</option>)}
						<option value="custom">직접 입력</option>
					</select>
				</div>
				<p class="mugu-hint" id="mugu-tool-hint"></p>
			</div>

			<div class="mugu-field mugu-field--full" id="mugu-custom-wrap" hidden>
				<label class="mugu-label" for="mugu-custom">직접 적는 무구</label>
				<div class="mugu-control">
					<input id="mugu-custom" name="customTool" type="text" maxlength="20" autocomplete="off" placeholder="예: 먹통, 장도, 단소" />
				</div>
			</div>

			<div class="mugu-field">
				<label class="mugu-label" for="mugu-concept">컨셉 <em>선택</em></label>
				<div class="mugu-control">
					<input id="mugu-concept" name="concept" type="text" maxlength="40" autocomplete="off" placeholder="예: 맑고 푸른 기운, 오래 묵어 조금 삐딱한 성미" />
				</div>
			</div>

			<div class="mugu-field mugu-field--half">
				<label class="mugu-label" for="mugu-material">재질 · 형태 <em>선택</em></label>
				<div class="mugu-control">
					<input id="mugu-material" name="material" type="text" maxlength="30" autocomplete="off" placeholder="예: 오동나무, 놋쇠 (비우면 알아서 정해 준다)" />
				</div>
			</div>

			<div class="mugu-field mugu-field--half">
				<label class="mugu-label" for="mugu-detail">바라는 쓰임 <em>선택</em></label>
				<div class="mugu-control">
					<input id="mugu-detail" name="detail" type="text" maxlength="40" autocomplete="off" placeholder="예: 길 찾기, 잡귀 쫓기" />
				</div>
			</div>
		</div>

		<p class="mugu-error" id="mugu-error" role="alert" hidden></p>
		<p class="mugu-status" id="mugu-status" role="status" hidden>대표실에서 어울리는 무구를 고르는 중이에요. 길게는 1분쯤 걸릴 수 있어요.</p>

		<div class="mugu-actions">
			<button type="button" class="mugu-btn mugu-btn-ghost" id="mugu-shuffle">랜덤 뽑기</button>
			<button type="submit" class="mugu-btn mugu-btn-main" id="mugu-submit">무구 받기</button>
		</div>
	</form>

	<p class="mugu-caption">Gemini Flash Lite 모델을 사용, 하루 5회 생성 횟수 제한</p>
	<p class="mugu-caption">무속 소재를 빌려온 재미용 허구입니다. 현실의 신앙이나 의례와는 관계가 없습니다.</p>

	<article class="mugu-receipt" id="mugu-receipt" tabindex="-1" aria-labelledby="mugu-item" hidden>
		<div class="mugu-receipt-top">
			<p class="mugu-receipt-kicker">무구 지급 확인서</p>
			<span class="stamp mugu-stamp" id="mugu-stamp">수령</span>
		</div>
		<h3 class="mugu-item"><span id="mugu-item"></span><span class="mugu-item-hanja" id="mugu-item-hanja" lang="zh-Hant" hidden></span></h3>
		<p class="mugu-meaning" id="mugu-item-meaning" hidden></p>
		<p class="mugu-deity"><span>모시는 신 · </span><span id="mugu-deity"></span><span class="mugu-deity-hanja" id="mugu-deity-hanja" lang="zh-Hant" hidden></span></p>
		<p class="mugu-meaning" id="mugu-meaning" hidden></p>
		<ul class="mugu-chips" id="mugu-chips"></ul>

		<div class="mugu-blocks">
			<section>
				<h4>형태</h4>
				<ul id="mugu-form-list"></ul>
			</section>
			<section>
				<h4>권능</h4>
				<ul id="mugu-ability-list"></ul>
			</section>
			<section>
				<h4>기술</h4>
				<ul class="mugu-skills" id="mugu-skill-list"></ul>
				<div class="mugu-ultimate" id="mugu-ultimate"></div>
			</section>
			<section>
				<h4>금기와 대가</h4>
				<ul id="mugu-taboo-list"></ul>
			</section>
		</div>

		<div class="mugu-receipt-foot">
			<span class="handwritten" id="mugu-note"></span>
			<div class="mugu-actions">
				<button type="button" class="mugu-btn mugu-btn-ghost" id="mugu-copy">문구 복사</button>
				<button type="button" class="mugu-btn mugu-btn-ghost" id="mugu-again">다시 받기</button>
			</div>
		</div>
	</article>
</section>

<script>
	import { ELEMENTS, SPIRITS, TOOLS } from '../data/mugu-options.js';
	import { compatibleElements, resolvePair } from '../data/mugu-selection.js';

	const API_URL = import.meta.env.PUBLIC_MUGU_API_URL || 'https://meonmeo437.vercel.app/api/generate-mugu';
	const REQUEST_TIMEOUT_MS = 58000;
	const NOTES = ['반납은 퇴사할 때만 받습니다.', '분실하면 대표님께 먼저 말할 것.', '함부로 휘두르지 말 것.'];
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const $ = (id) => document.getElementById(id);
	const form = $('mugu-form');
	const lists = { spirit: SPIRITS, element: ELEMENTS, tool: TOOLS };
	const selects = { spirit: $('mugu-spirit'), element: $('mugu-element'), tool: $('mugu-tool') };
	const customWrap = $('mugu-custom-wrap');
	const customInput = $('mugu-custom');
	const materialInput = $('mugu-material');
	const detailInput = $('mugu-detail');
	const conceptInput = $('mugu-concept');
	const errorEl = $('mugu-error');
	const statusEl = $('mugu-status');
	const buttons = [$('mugu-shuffle'), $('mugu-submit'), $('mugu-copy'), $('mugu-again')];
	const submitButton = $('mugu-submit');
	const receipt = $('mugu-receipt');
	const stamp = $('mugu-stamp');
	const copyButton = $('mugu-copy');

	let busy = false;
	let lastText = '';

	const pick = (list) => list[Math.floor(Math.random() * list.length)];

	function describe(key) {
		const value = selects[key].value;
		const hint = $(`mugu-${key}-hint`);
		if (value === 'random') hint.textContent = '미지정 항목은 대표실에서 일괄 배정합니다.';
		else if (value === 'custom') hint.textContent = '정해진 무구 말고 쓰고 싶은 물건이 있다면 직접 적는다.';
		else hint.textContent = lists[key].find((item) => item.id === value)?.desc ?? '';
	}

	function updateElementOptions() {
		const spirit = SPIRITS.find((item) => item.id === selects.spirit.value);
		const allowed = new Set(compatibleElements(spirit).map((item) => item.id));
		for (const option of selects.element.options) {
			if (option.value === 'random') continue;
			const element = ELEMENTS.find((item) => item.id === option.value);
			if (!element) continue;
			option.disabled = !allowed.has(element.id);
			option.textContent = `${element.name}(${element.hanja}) · ${element.trait}${option.disabled ? ' — 상극 · 선택 불가' : ''}`;
		}
		const reset = selects.element.selectedOptions[0]?.disabled;
		if (reset) selects.element.value = 'random';
		describe('element');
		if (spirit && allowed.size < ELEMENTS.length) {
			$('mugu-element-hint').textContent += reset
				? ` ${spirit.name}과 상극인 기운이므로 랜덤으로 변경했습니다.`
				: ` ${spirit.name}과 상극인 기운은 선택할 수 없습니다.`;
		}
	}

	function setBusy(next, label) {
		busy = next;
		form.setAttribute('aria-busy', String(next));
		buttons.forEach((button) => (button.disabled = next));
		submitButton.textContent = next && label ? label : '무구 받기';
		$('mugu-again').textContent = next && label ? label : '다시 받기';
		statusEl.hidden = !(next && label);
		receipt.classList.toggle('is-loading', next && Boolean(label));
	}

	function showError(message) {
		errorEl.textContent = message;
		errorEl.hidden = false;
	}

	function clearError() {
		errorEl.hidden = true;
		errorEl.textContent = '';
	}

	Object.keys(selects).forEach((key) => {
		describe(key);
		selects[key].addEventListener('change', () => {
			describe(key);
			if (key === 'spirit' || key === 'element') updateElementOptions();
			if (key === 'tool') {
				const custom = selects.tool.value === 'custom';
				customWrap.hidden = !custom;
				if (custom) customInput.focus();
			}
			clearError();
		});
	});

	updateElementOptions();

	function shuffleAll() {
		if (busy) return;
		clearError();
		const settle = () => {
			const pair = resolvePair('random', 'random');
			selects.spirit.value = pair.spirit.id;
			selects.element.value = pair.element.id;
			selects.tool.value = pick(TOOLS).id;
			describe('spirit');
			describe('tool');
			updateElementOptions();
			customWrap.hidden = true;
		};
		if (reduceMotion) {
			settle();
			return;
		}
		busy = true;
		buttons.forEach((button) => (button.disabled = true));
		form.classList.add('is-rolling');
		let ticks = 0;
		const timer = window.setInterval(() => {
			settle();
			ticks += 1;
			if (ticks >= 9) {
				window.clearInterval(timer);
				form.classList.remove('is-rolling');
				busy = false;
				buttons.forEach((button) => (button.disabled = false));
			}
		}, 80);
	}

	function resolveSelection() {
		const find = (key) => {
			const value = selects[key].value;
			if (value === 'random') return pick(lists[key]);
			return lists[key].find((item) => item.id === value);
		};

		let tool = '';
		let customTool = '';
		if (selects.tool.value === 'custom') {
			customTool = customInput.value.trim();
			if (!customTool) {
				showError('직접 적을 무구 이름을 입력해 주세요.');
				customInput.focus();
				return null;
			}
		} else {
			tool = find('tool').name;
		}

		const pair = resolvePair(selects.spirit.value, selects.element.value);
		if (!pair) {
			showError('선택한 신과 기운이 상극입니다. 기운을 다시 선택해 주세요.');
			return null;
		}
		return {
			element: pair.element.name,
			spirit: pair.spirit.name,
			tool,
			customTool,
			material: materialInput.value.trim(),
			detail: detailInput.value.trim(),
			concept: conceptInput.value.trim(),
		};
	}

	function getAdminToken() {
		return new URLSearchParams(location.search).get('dev') || '';
	}

	async function requestSheet(selection) {
		let res;
		const controller = new AbortController();
		const timer = window.setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
		try {
			res = await fetch(API_URL, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ ...selection, adminToken: getAdminToken() }),
				signal: controller.signal,
			});
		} catch (error) {
			throw new Error(
				error?.name === 'AbortError'
					? '대표실 응답이 너무 늦어지고 있어요. 잠시 후 다시 시도해 주세요.'
					: '서버에 연결할 수 없어요. 잠시 후 다시 시도해 주세요.',
			);
		} finally {
			window.clearTimeout(timer);
		}

		let data = null;
		try {
			data = await res.json();
		} catch {
			// 본문이 JSON이 아니면 아래 공통 오류 문구로 처리한다.
		}
		if (!res.ok || !data?.ok) {
			throw new Error(data?.message || '무구를 내어주지 못했어요. 잠시 후 다시 시도해 주세요.');
		}
		return data.sheet;
	}

	function fillList(id, items) {
		$(id).replaceChildren(
			...items.map((text) => {
				const li = document.createElement('li');
				li.textContent = text;
				return li;
			}),
		);
	}

	function skillNode(tag, skill, tagName) {
		const node = document.createElement(tag);
		const label = document.createElement('span');
		label.className = 'mugu-skill-tag';
		label.textContent = tagName;
		const name = document.createElement('strong');
		name.textContent = skill.name;
		const desc = document.createElement('p');
		desc.textContent = skill.desc;
		node.append(label, name, desc);
		return node;
	}

	function renderSkills(skills, ultimate) {
		const list = $('mugu-skill-list');
		list.replaceChildren(...skills.map((skill) => skillNode('li', skill, '스킬')));
		list.hidden = skills.length === 0;
		const ultimateEl = $('mugu-ultimate');
		ultimateEl.replaceChildren(...(ultimate ? [skillNode('div', ultimate, '필살기')] : []));
		ultimateEl.hidden = !ultimate;
	}

	function renderSheet(result, selection) {
		$('mugu-deity').textContent = result.deityName;
		const hanjaEl = $('mugu-deity-hanja');
		hanjaEl.textContent = result.deityHanja || '';
		hanjaEl.hidden = !result.deityHanja;
		const meaningEl = $('mugu-meaning');
		meaningEl.textContent = result.deityMeaning || '';
		meaningEl.hidden = !result.deityMeaning;
		$('mugu-item').textContent = result.itemName;
		const itemMeaningEl = $('mugu-item-meaning');
		itemMeaningEl.textContent = result.itemMeaning || '';
		itemMeaningEl.hidden = !result.itemMeaning;
		const itemHanjaEl = $('mugu-item-hanja');
		itemHanjaEl.textContent = result.itemHanja || '';
		itemHanjaEl.hidden = !result.itemHanja;

		const chips = [
			['기운', selection.element],
			['모시는 신', selection.spirit],
			['무구', selection.tool || selection.customTool],
		];
		$('mugu-chips').replaceChildren(
			...chips.map(([label, value]) => {
				const li = document.createElement('li');
				const b = document.createElement('b');
				b.textContent = label;
				li.append(b, document.createTextNode(value));
				return li;
			}),
		);

		fillList('mugu-form-list', result.form);
		fillList('mugu-ability-list', result.abilities);
		fillList('mugu-taboo-list', result.taboos);
		renderSkills(result.skills || [], result.ultimate);
		$('mugu-note').textContent = pick(NOTES);

		lastText = [
			'# user의 무구',
			'## 모시는 신',
			`* ${result.deityName}${result.deityHanja ? `(${result.deityHanja})` : ''}`,
			`* 기운: ${selection.element}`,
			'## 무구',
			`* 유형: ${selection.tool || selection.customTool}`,
			`* 이름: ${result.itemName}${result.itemHanja ? `(${result.itemHanja})` : ''}`,
			'## 형태',
			...result.form.map((line) => `* ${line}`),
			'## 권능',
			...result.abilities.map((line) => `* ${line}`),
			'## 기술',
			...(result.skills || []).map((skill) => `* ${skill.name}: ${skill.desc}`),
			...(result.ultimate ? [`* [필살기] ${result.ultimate.name}: ${result.ultimate.desc}`] : []),
			'## 금기와 대가',
			...result.taboos.map((line) => `* ${line}`),
		].join('\n');

		receipt.hidden = false;
		receipt.classList.remove('is-new');
		stamp.classList.remove('is-stamped');
		void receipt.offsetWidth;
		receipt.classList.add('is-new');
		stamp.classList.add('is-stamped');
		receipt.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
		receipt.focus({ preventScroll: true });
	}

	async function issue() {
		if (busy) return;
		clearError();
		const selection = resolveSelection();
		if (!selection) return;

		setBusy(true, '지급 중…');
		try {
			renderSheet(await requestSheet(selection), selection);
		} catch (error) {
			showError(error.message || '무구를 내어주지 못했어요. 잠시 후 다시 시도해 주세요.');
		} finally {
			setBusy(false);
		}
	}

	function fallbackCopy(text) {
		const textarea = document.createElement('textarea');
		textarea.value = text;
		textarea.style.position = 'fixed';
		textarea.style.opacity = '0';
		document.body.appendChild(textarea);
		textarea.focus();
		textarea.select();
		try {
			document.execCommand('copy');
		} finally {
			document.body.removeChild(textarea);
		}
	}

	function copyResult() {
		if (!lastText) return;
		const markCopied = () => {
			copyButton.textContent = '복사됨';
			window.setTimeout(() => (copyButton.textContent = '문구 복사'), 1500);
		};
		if (navigator.clipboard?.writeText) {
			navigator.clipboard.writeText(lastText).then(markCopied, () => {
				fallbackCopy(lastText);
				markCopied();
			});
		} else {
			fallbackCopy(lastText);
			markCopied();
		}
	}

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		issue();
	});
	$('mugu-shuffle').addEventListener('click', shuffleAll);
	$('mugu-again').addEventListener('click', issue);
	copyButton.addEventListener('click', copyResult);
</script>

<style is:global>
	.mugu [hidden] {
		display: none !important;
	}

	.mugu-sheet,
	.mugu-receipt {
		position: relative;
		background: var(--sheet);
		border: 1px solid var(--line);
		box-shadow: 5px 6px 0 var(--wash);
	}

	.mugu-sheet {
		padding: 26px 32px 30px;
	}

	.mugu-sheet-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 20px;
		padding-bottom: 18px;
		margin-bottom: 24px;
		border-bottom: 1px solid var(--line);
	}

	.mugu-sheet-kicker {
		font-size: 12px;
		letter-spacing: 0.13em;
		color: var(--red);
	}

	.mugu-sheet-head h3 {
		margin-top: 4px;
		font: 700 24px/1.5 var(--serif);
		letter-spacing: -0.03em;
	}

	.mugu-fields {
		display: grid;
