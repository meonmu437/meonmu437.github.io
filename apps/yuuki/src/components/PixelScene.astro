---
import WorldStatue from './WorldStatue.astro';
import {worldArtworks} from '../../public/exploration-data.js';
const nodes=[{id:'save',x:95,y:235,label:'세이브 지점',n:'S'},{id:'campus',x:215,y:235,label:'한국대학교',n:'1'},{id:'rest',x:360,y:140,label:'유우키의 방',n:'2'},{id:'family',x:505,y:140,label:'원거리 통신',n:'3'},{id:'continue',x:505,y:235,label:'사랑의 던전',n:'4'}];
const trees=[[76,130],[113,105],[260,73],[290,93],[375,65],[568,225],[130,266],[277,263],[310,183],[340,270]];
---
<svg id="world-map" viewBox="0 0 640 300" role="group" aria-label="유우키의 캠페인 월드맵" shape-rendering="crispEdges">
<defs>
 <pattern id="sea" width="32" height="24" patternUnits="userSpaceOnUse"><rect width="32" height="24" fill="#6aa6cc"/><path d="M5 8h3V6h4v2h3M23 20h3v-2h4v2h2" fill="none" stroke="#a5d4df" stroke-width="2"/></pattern>
 <pattern id="grass-tile" width="24" height="24" patternUnits="userSpaceOnUse"><rect width="24" height="24" fill="#8bac6c"/><path d="M4 8h2v-2h2v2h2M17 20h2v-2h2v2" stroke="#a9be7b" stroke-width="1" fill="none"/></pattern>
 <symbol id="hero-sprite" viewBox="0 0 24 32"><path d="M4 13h15v15H4z" fill="#496b99"/><path d="M7 3h10v3h3v7h-3v3H7v-3H4V6h3z" fill="#e8c59b"/><path d="M6 2h12v3h3v5h-4V7H7v3H3V5h3z" fill="#e5dbb1"/><path d="M10 0h4v4h-4z" fill="#d49b59"/><path d="M7 10h3v3H7zm8 0h2v3h-2z" fill="#344442"/><path d="M7 16h11v10H7z" fill="#c8d2c1"/><path d="M7 19h11v3H7z" fill="#8ba49e"/><path d="M7 26h4v6H5v-3h2zm7 0h4v3h2v3h-6z" fill="#67523e"/><path d="M1 18h4v10H1z" fill="#b79754"/><path d="M21 14h2v13h-2z" fill="#f2edd2"/><path d="M19 24h5v2h-5z" fill="#c7a254"/></symbol>
</defs>
<rect width="640" height="300" fill="url(#sea)"/>
<path d="M64 66h95V45h130v15h135V40h121v28h44v180h-24v34H407v-17H282v20H87v-23H45V119h19z" fill="#596f59"/>
<path d="M68 62h95V41h122v15h143V36h113v28h44v180h-24v34H411v-17H278v20H91v-23H49V123h19z" fill="#e9d69c"/>
<path d="M80 74h94V53h99v15h168V48h88v28h44v156h-24v34H423v-17H266v20H103v-23H61V135h19z" fill="url(#grass-tile)"/>
<path d="M95 235h120V140h290v95" fill="none" stroke="#695c43" stroke-width="13"/><path d="M95 235h120V140h290v95" fill="none" stroke="#f5e6b6" stroke-width="7"/><path d="M95 235h120V140h290v95" fill="none" stroke="#b6a674" stroke-width="1" stroke-dasharray="3 6"/>
<path d="M124 160h47v37h-47zm273 22h49v36h-49z" fill="#6aa6cc" stroke="#d8c78e" stroke-width="5"/><path d="M132 170h10v-2h8m255 29h12v-2h9" stroke="#b6e1e5" stroke-width="2" fill="none"/>
{trees.map(([x,y])=><g transform={`translate(${x} ${y})`} aria-hidden="true"><rect x="6" y="17" width="5" height="9" fill="#6c6144"/><path d="M5 0h9v4h5v12h-4v5H0V6h5z" fill="#4e7952"/><path d="M5 0h9v4h-5v6H3V6h2z" fill="#bfd087"/><path d="M0 16h15v5H0z" fill="#35634b"/></g>)}
<g aria-hidden="true"><path d="M126 58l18-33 18 33zm28 0l21-40 21 40z" fill="#8b9c84"/><path d="M138 37l6-12 7 12zm30-6l7-13 7 13z" fill="#e8e5bf"/><path d="M284 52h32v3h5v8h-42v-8h5zM471 20h34v4h7v8h-48v-8h7zM18 39h26v4h8v8H10v-8h8z" fill="#e7ead0"/>
<rect x="190" y="177" width="51" height="39" fill="#bfaa7b"/><path d="M186 173h59v7h-59zm9-7h41v7h-41z" fill="#65736a"/><path d="M209 192h13v24h-13z" fill="#435b54"/><path d="M197 184h6v8h-6zm31 0h6v8h-6z" fill="#f3dfa1"/>

<g transform="translate(-145 0)"><rect x="484" y="85" width="43" height="35" fill="#d1c294"/><path d="M479 83h53v6h-53zm7-7h39v7h-39zm9-6h21v6h-21z" fill="#537c71"/><rect x="501" y="104" width="10" height="16" fill="#687d61"/>
</g>
<g transform="translate(145 0)"><path d="M357 99h6v17h-6z" fill="#82785b"/><path d="M342 80h32v24h-32z" fill="#749c97"/><path d="M342 80h32v5h-32zM347 90h22v4h-22z" fill="#b4d1b4"/><path d="M374 82h5v18h-5z" fill="#b57b70"/><path d="M374 80h13v6h-13z" fill="#deb18a"/>
</g>
<g aria-hidden="true"><path d="M479 179h13v35h-13zm39 0h13v35h-13zM489 184h33v30h-33z" fill="#a28aa0"/><path d="M476 179h19v5h-19zm39 0h19v5h-19z" fill="#dfb0ad"/><path d="M479 172h4v7h-4zm8 0h5v7h-5zm31 0h4v7h-4zm8 0h5v7h-5z" fill="#c9a6a3"/><path d="M498 196h14v18h-14z" fill="#4d4b68"/><path d="M498 196h4v-4h6v4h4" fill="none" stroke="#e4c59e" stroke-width="2"/><path d="M498 164h5v3h4v-3h5v3h3v6h-3v3h-3v3h-7v-3h-3v-3h-3v-6h2z" fill="#e496ad"/><path d="M499 167h3v3h-3z" fill="#ffe6c4"/><path d="M470 159h2v8h-2zm-3 3h8v2h-8zM537 174h2v8h-2zm-3 3h8v2h-8z" fill="#ead9a4"/></g>

</g>
{nodes.map(node=><g class="map-node" data-node={node.id} role="button" tabindex="0" aria-label={`${node.label}(으)로 이동`}><title>{node.label}</title><rect class="node-hit" x={node.x-18} y={node.y-18} width="36" height="36" fill="transparent"/><rect class="node-shadow" x={node.x-10} y={node.y-8} width="22" height="22" fill="#4e624d"/><rect class="node-tile" x={node.x-11} y={node.y-11} width="22" height="22" fill="#f1dfac" stroke="#6b6046" stroke-width="2"/><text x={node.x} y={node.y+4} text-anchor="middle" fill="#4f5746" font-size="12" font-family="Galmuri">{node.n}</text></g>)}
{worldArtworks.map(art=><WorldStatue art={art}/>)}
<g id="world-player" pointer-events="none" transform="translate(83 204)"><ellipse cx="12" cy="31" rx="10" ry="3" fill="#405a4666"/><use href="#hero-sprite" width="24" height="32"/></g>
</svg>
