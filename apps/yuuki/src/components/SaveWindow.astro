---
const records=[
 {stage:'초등학생',place:'일본',title:'처음의 마을',description:'가족의 사랑을 듬뿍 받은 막내. 첫 모험은 여기서 시작됐다.'},
 {stage:'중학생',place:'서울',title:'이름 없는 선물',description:'두꺼운 안경 너머 첫사랑을 만났다. 이름을 적지 못한 선물을 남겨 두었다.'},
 {stage:'고등학생',place:'일본',title:'멀어진 세이브 지점',description:'일본으로 돌아왔지만, 서울에 두고 온 마음은 회수하지 못했다.'},
 {stage:'대학생',place:'서울 · 한국대학교',title:'다시 만난 첫사랑',description:'다시 만날지도 모른다는 미련으로 한국에 진학했다. 그리고 당신과 재회했다.'},
];
---
<section id="save-dialog" class="save-overlay" aria-labelledby="save-title" role="dialog" aria-modal="true" hidden>
 <div class="retro-save-window">
  <header><h2 id="save-title">SAVE DATA</h2><div class="retro-save-actions"><button type="button" id="save-progress">현재 위치 저장</button><button type="button" id="load-progress" disabled>불러오기</button><button type="button" id="close-save" aria-label="세이브 창 닫기">×</button></div></header>
  <ol class="retro-save-list" aria-label="저장된 이야기">{records.map((record,i)=><li><button type="button" data-save-record={i} data-save-description={record.description} aria-pressed={i===3}>
   <span class="retro-save-number"><span class="save-row-cursor" aria-hidden="true">▶</span>{String(i+1).padStart(2,'0')}</span>
   <span class="retro-save-copy"><strong>{record.title}</strong><span>{record.stage} · {record.place}</span></span>
  </button></li>)}</ol>
  <div class="retro-save-description" id="save-record-description" aria-live="polite">{records[3].description}</div>
  <footer><span id="save-slot-detail">아직 저장하지 않은 탐색 위치</span><p id="save-feedback" role="status"></p></footer>
 </div>
</section>
