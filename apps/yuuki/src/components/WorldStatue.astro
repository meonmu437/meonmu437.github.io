---
const {art}=Astro.props;
const drawX=art.kind==='duck'?art.x+32:art.x-22;
const drawY=art.kind==='duck'?art.y-52:art.y-86;
---
<g class="map-node world-artwork" data-node={art.id} role="button" tabindex="0" aria-label={`${art.title} 구경하기`}>
<title>{art.title}</title>
<rect class="node-hit" x={drawX-2} y={drawY} width="48" height="87" fill="transparent"/>
<g transform={`translate(${drawX} ${drawY})`} aria-hidden="true">
<ellipse cx="22" cy="68" rx="22" ry="5" fill="#53684d77"/>
<path d="M5 60h34v8H5zM2 67h40v5H2z" fill="#829383"/><path d="M5 60h34v3H5zM4 67h36v2H4z" fill="#d4d6b5"/>
{art.kind==='rabbit'&&<><path d="m5 54 30-5 5 4-30 7-7-2z" fill="#8bada2"/><path d="m7 54 28-4" stroke="#dce2ba" stroke-width="2"/><path d="M12 40h18v10H12zm5-17h14v19H14V28h3zM17 2h6v22h-6zm12 2h6v24h-6z" fill="#e5e3cd"/><path d="M18 5h3v14h-3zm12 3h3v13h-3z" fill="#bbc3b1"/><path d="M27 27h3v3h-3z" fill="#5c776b"/><path d="m14 36-8 6m19-5 10-4M16 48l-6 6m15-6 5 4" fill="none" stroke="#d5d8c4" stroke-width="5"/></>}
