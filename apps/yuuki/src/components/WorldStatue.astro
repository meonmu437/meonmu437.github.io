{art.kind==='tiger'&&<><path d="M13 26h19v25H13zM9 10h27v21H9zM8 6h8v9H8zm21 0h8v9h-8zM9 48h10v10H9zm17 0h10v10H26z" fill="#e2dfc5"/><path d="M10 16h6v3h-6zm21 0h5v3h-5zM20 10h4v8h-4zm-7 20h5v3h-5zm15 4h5v3h-5z" fill="#8fa18d"/><path d="M16 20h3v3h-3zm12 0h3v3h-3zM21 26h5v2h-5z" fill="#557366"/><path d="m13 29 20 20" stroke="#9a8e6e" stroke-width="4"/><path d="M27 41h12v12H27z" fill="#b1a182"/><path d="M32 28h9v13h-9z" fill="#f0ead1"/><path d="M34 31h5m-5 4h5" stroke="#8ba18f" stroke-width="1"/><path d="M10 37H5V24H2" stroke="#c4cfb9" stroke-width="5" fill="none"/></>}
