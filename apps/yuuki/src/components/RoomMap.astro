---
import {roomObjects} from '../../public/exploration-data.js';
---
<svg id="rest-map" class="exploration-map" viewBox="0 0 640 320" shape-rendering="crispEdges" role="group" aria-label="유우키의 복층 자취방 탐험 지도" tabindex="0">
<defs><pattern id="home-floor" width="40" height="24" patternUnits="userSpaceOnUse"><rect width="40" height="24" fill="#d0bb92"/><path d="M0 23h40M20 0v23" stroke="#bca780"/></pattern></defs>
<rect width="640" height="320" fill="#53665f"/><rect x="16" y="12" width="608" height="294" fill="url(#home-floor)"/>
<path d="M16 75V12h608v63" fill="#b9c9bd" stroke="#7d9588" stroke-width="5"/>
<rect x="48" y="22" width="164" height="45" fill="#82acb8" stroke="#eee4bf" stroke-width="5"/><path d="M130 22v45M48 45h164" stroke="#e4dcc2" stroke-width="3"/><path d="m60 57 16-14 17 14 24-23 24 23 23-16 29 16" fill="#749889"/>
<rect x="408" y="21" width="208" height="160" fill="#ac997b"/><path d="M408 181h208M408 23v158" stroke="#7f795f" stroke-width="5"/>
<text x="510" y="117" text-anchor="middle" class="scene-map-label">복층 · 잠자는 곳</text>
<path d="M377 78h27v100h-27z" fill="#b79c72"/>{[0,1,2,3,4,5].map(i=><path d={`M377 ${83+i*16}h27`} stroke="#f0d2a0" stroke-width="3"/>)}
<rect x="266" y="164" width="88" height="30" fill="#a4b4a0"/><path d="M270 168h80v22h-80z" fill="none" stroke="#d0d5b1"/>
{roomObjects.map(o=><g class="scene-object" data-inspect={o.id} data-owner="rest" role="button" tabindex="0" aria-label={`${o.name} 조사하기`}><title>{o.name}</title>
<rect x={o.x+3} y={o.y+5} width={o.w} height={o.h} fill="#746f5966"/>
<rect x={o.x} y={o.y} width={o.w} height={o.h} fill={['fridge','bath','kitchen'].includes(o.kind)?'#dbe0cb':o.kind==='sofa'?'#839b8b':o.kind==='bed'?'#e3d9b9':o.kind==='tin'?'#829ba0':o.kind==='diary'?'#a88582':'#a88d66'} stroke="#6c7c68" stroke-width="2"/>
{o.kind==='desk'&&<><path d={`M${o.x+8} ${o.y+9}h110m-110 5h110`} stroke="#cbb588"/><rect x={o.x+10} y={o.y-17} width="23" height="20" fill="#d7c68f"/><path d={`M${o.x+17} ${o.y-17}v-13h23v7`} fill="none" stroke="#627c70" stroke-width="4"/><path d={`M${o.x+62} ${o.y+13}h9v12h-9zm20 5h11v9H${o.x+82}z`} fill="#d9d7b4"/><path d={`M${o.x+66} ${o.y+17}h2m19 5h2`} stroke="#4d6658" stroke-width="2"/></>}
{o.kind==='bed'&&<><rect x={o.x+7} y={o.y+5} width="29" height={o.h-10} fill="#f0ebd5"/><rect x={o.x+42} y={o.y+4} width={o.w-47} height={o.h-8} fill="#8ca99c"/><path d={`M${o.x+45} ${o.y+12}h${o.w-53}m0 10h-${o.w-53}m0 10h${o.w-53}`} stroke="#b6c7ad" stroke-width="3"/></>}
{o.kind==='books'&&Array.from({length:7},(_,i)=><rect x={o.x+5+i*9} y={o.y+8} width="6" height="31" fill={['#b2c1a0','#c49d88','#819fa7'][i%3]}/>)}
{o.kind==='oven'&&<><rect x={o.x+5} y={o.y+10} width={o.w-10} height="22" fill="#3f5555"/><path d={`M${o.x+8} ${o.y+5}h5m5 0h5m5 0h5`} stroke="#d8d1ad" stroke-width="3"/><path d={`M${o.x+15} ${o.y+21}h5v6h-5zm9-3h5v9h-5z`} fill="#d7c59d"/></>}
{o.kind==='kitchen'&&<><circle cx={o.x+20} cy={o.y+27} r="13" fill="#738e8d" stroke="#e5e5d1" stroke-width="3"/><path d={`M${o.x+46} ${o.y+7}h22v12h-22z`} fill="#3e5553"/></>}
{o.kind==='bath'&&<><rect x={o.x+7} y={o.y+5} width={o.w-14} height={o.h-10} fill="#b1cbc5"/><path d={`M${o.x+15} ${o.y+10}v30m13-30v30m13-30v30`} stroke="#dce8d5"/></>}
{o.kind==='sofa'&&<><path d={`M${o.x+7} ${o.y+8}h${o.w-14}v16h-${o.w-14}z`} fill="#a6bda3"/><path d={`M${o.x+o.w/2} ${o.y+27}v18`} stroke="#617d70" stroke-width="3"/></>}
{['fridge','drawer','tin','diary'].includes(o.kind)&&<path d={`M${o.x+6} ${o.y+o.h/2}h${o.w-12}m-${o.w-15} 5h7`} fill="none" stroke="#e6dec2" stroke-width="2"/>}
{o.kind==='cushion'&&<path d={`M${o.x+5} ${o.y+5}h21v21h-21z`} fill="#e0c8ad"/>}
{o.kind==='shoes'&&<path d={`M${o.x+4} ${o.y+4}h10v16H${o.x+1}v-6h3zm21 0h10v16H${o.x+22}v-6h3z`} fill="#435b62"/>}
{o.kind==='door'&&<text x={o.x+o.w/2} y={o.y+19} text-anchor="middle" class="room-door-label">나가기</text>}
<rect class="scene-hit" x={o.x-4} y={o.y-4} width={o.w+8} height={o.h+8} fill="transparent"/>
</g>)}
<g id="rest-player" class="exploration-player" transform="translate(492 233)" pointer-events="none"><ellipse cx="12" cy="31" rx="10" ry="3" fill="#5a563b66"/><use href="#hero-sprite" width="24" height="32"/></g>
</svg>
