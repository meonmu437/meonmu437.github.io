---
const items=[
 {id:'univers',platform:'유니챗',name:'흰오목눈이',available:true,description:'손바닥만 한 하얀 새. 전하고 싶은 말을 맡기면, 주인보다 먼저 용기를 낸다.'},
 {id:'elyn',platform:'엘린',name:'마법사 모자',available:true,description:'남의 말을 안 듣는 성격 나쁜 마법사의 모자. 주문 하나는 기막히게 읊어서 버리기도 아깝다.'},
 {id:'teapot',platform:'티팟',name:'작은 찻주전자',available:true,description:'따뜻한 차 두 잔이 나온다. 따르는 손이 떨리지만 않으면 회복 효과는 확실하다.'},
];
---
<section id="campaign-overlay" class="campaign-overlay" hidden aria-labelledby="campaign-heading" role="dialog" aria-modal="true">
 <div class="campaign-game-window dungeon-item-window" data-item-theme="univers">
  <header><strong id="campaign-heading">ITEM SELECT</strong><button type="button" id="close-campaign" aria-label="월드맵으로 돌아가기">돌아가기 ×</button></header>
  <div class="dungeon-item-body"><div class="dungeon-item-intro"><h2><svg class="dungeon-floating-heart" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true"><path d="M2 2h4v2h4V2h4v2h2v6h-2v2h-2v2h-2v2H6v-2H4v-2H2v-2H0V4h2Z" fill="#dfa2b6"/><path d="M2 4h3v2H2z" fill="#f7d9cc"/></svg><span>짝사랑의 던전</span></h2><div class="dungeon-entry-stats"><span>입장 레벨 <strong>???</strong></span><span>난이도 <strong>???</strong></span></div><p>함께 갈 아이템을 고르세요.</p></div>
   <div class="dungeon-item-list" role="group" aria-label="들고 갈 아이템">{items.map((item,i)=><button type="button" class={`dungeon-item ${item.id}`} data-dungeon-item={item.id} data-item-name={item.name} data-item-description={item.description} aria-pressed={i===0}>
    <span class="dungeon-item-platform"><span class="dungeon-item-cursor" aria-hidden="true">▶</span>{item.platform}</span>
    <span class="dungeon-item-art" aria-hidden="true"><svg viewBox="0 0 48 48" shape-rendering="crispEdges">
    {item.id==='univers'&&<>
     <path d="M29 21h4v-6h4V9h4V3h3v10h-3v8h-4v7h-8z" fill="#a9b9b6"/><path d="M34 18h3v-6h3V7h2v7h-3v7h-3v5h-4z" fill="#d5ded4"/>
     <path d="M12 13h18v3h6v6h3v12h-3v5h-5v3H12v-3H7v-5H4V23h3v-6h5z" fill="#edf1e7"/>
     <path d="M12 13h18v3h5v6h-4v-3h-4v-3H15v3h-4v5H7v-7h5z" fill="#9aa9a7"/>
     <path d="M14 14h14v3h4v6h-5v-5H14v5h-4v-5h4zM10 19h5v12h-3v4H7V24h3zM31 21h5v12h-4v3h-4v-6h3z" fill="#f8f8ef"/>
     <path d="M7 28h3v8h5v4h14v-3h5v-7h4v5h-3v4h-5v3H12v-3H8v-5H5v-6z" fill="#d2ded6"/>
     <path d="M11 25h4v4h-4zm15 0h4v4h-4z" fill="#253d3b"/><path d="M11 25h1v1h-1zm15 0h1v1h-1z" fill="#f4f4e9"/>
     <path d="M19 29h3v2h2v2h-7v-2h2z" fill="#344a48"/><path d="M15 41h4v3h-4zm10 0h4v3h-4z" fill="#7d8f85"/>
     <path d="M3 9h2v7H3zm-2 3h6v2H1z" fill="#e6b5cc"/>
    </>}
    {item.id==='elyn'&&<><path d="M23 3h9v5h-5v6h4v8h4v10H12V22h4v-9h4V7h3z" fill="#a18bc7"/><path d="M23 9h4v5h-3v16h-8V23h4V13h3z" fill="#c6b5df"/><path d="M8 30h29v4h6v6H4v-6h4z" fill="#715d91"/><path d="M12 28h23v5H12z" fill="#dbc58d"/><path d="M27 29h5v5h-5z" fill="#eae0b9"/><path d="M26 17h3v3h-3zm-7 6h3v3h-3zM36 9h2v7h-2zm-3 3h8v2h-8z" fill="#f1dfac"/></>}
    {item.id==='teapot'&&<><path d="M13 18h21v20H13zM17 14h13v4H17zM10 23h6v12h-6zM33 19h5v3h-5zM38 20h5v6h-5zM35 25h8v6h-8zM7 17h5v7H7zM3 13h7v6H3z" fill="#9ebea1"/><path d="M17 20h7v15h-7zM14 37h18v3H14z" fill="#ccdcc0"/><path d="M12 13h22v3H12zM20 8h8v5h-8z" fill="#c8b379"/><path d="M21 24h6v3h-6zm0 3h3v3h-3z" fill="#dce6c6"/><path d="M17 3v3h-3v3m15-7v3h-3v3" stroke="#d0d9b9" stroke-width="2" fill="none"/></>}
    </svg></span>
    <strong>{item.name}</strong><small>{item.available?'입수 가능':'아직 잠겨 있음'}</small>
   </button>)}</div>
   <section class="dungeon-item-detail" aria-live="polite"><h3 id="dungeon-selected-name">{items[0].name}</h3><p id="dungeon-selected-description">{items[0].description}</p></section>
   <div class="dungeon-item-confirm"><a id="dungeon-enter" href="https://www.univers.chat/character/f8df5746-19d5-403d-8b2a-67e26ed181a1" target="_blank" rel="noopener noreferrer">작은 새와 입장하기 ↗</a><button type="button" id="dungeon-locked" disabled hidden>아직 가져갈 수 없어요</button></div>
  </div>
  <footer>아이템 하나, 용기 조금.<span>ESC · 월드맵</span></footer>
 </div>
</section>
