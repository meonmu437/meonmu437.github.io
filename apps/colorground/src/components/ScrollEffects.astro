---
// 위키 전체 페이지에 스크롤 연출(등장 애니메이션, 사이드바 스크롤스파이)을
// 담당하는 로직 전용 컴포넌트. 시각적 출력은 없음.
//
// 히어로 카드는 각자 뒤에 상세 프로필(외모/무기/필살기/좋아하는 것)이 바로 이어지므로,
// 스티키 핀 스택은 쓰지 않는다 — 카드 사이에 많은 콘텐츠가 끼면 핀이 다음 카드 위치까지
// 계속 고정되어 뒤 내용과 겹치는 문제가 생긴다. 대신 다른 섹션과 동일한 페이드인만 적용.
---

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function setUpReveals() {
		if (prefersReduced) return;
		document.querySelectorAll<HTMLElement>('.cg-reveal').forEach((el) => {
			gsap.set(el, { opacity: 0, y: 32 });
			gsap.to(el, {
				opacity: 1,
				y: 0,
				duration: 0.7,
				ease: 'power2.out',
				scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' },
			});
		});
		ScrollTrigger.refresh();
	}

	// A page that loads directly on a URL hash (e.g. a sidebar link's
	// `#sec-heroes`, or a shared link) has the browser jump to that anchor
	// before the custom webfonts (Jua, Noto Sans KR) swap in. That swap
	// resizes every heading above the target, pushing it further down the
	// page, so the initial jump lands short. Re-scroll to the hash target
	// to correct for the reflow.
	//
	// This is done more than once because it's not fully predictable when
	// the browser performs its own native fragment scroll relative to our
	// script running — on some loads it happens after our first correction
	// and overrides it. Calling scrollIntoView() again once things have
	// settled is cheap and a no-op if we're already in the right place.
	function correctHashScroll() {
		if (!location.hash) return;
		document.querySelector(location.hash)?.scrollIntoView();
	}

	async function settleThenInit() {
		correctHashScroll();
		if (document.fonts?.ready) {
			try {
				await document.fonts.ready;
			} catch {
				// ignore — fall through and init anyway
			}
		}
		correctHashScroll();
		setUpReveals();
		setTimeout(correctHashScroll, 300);
	}

	if (document.readyState === 'complete') {
		settleThenInit();
	} else {
		window.addEventListener('load', settleThenInit);
	}

	// 사이드바 스크롤스파이: 현재 보이는 섹션에 해당하는 사이드바 링크를 강조
	const sections = document.querySelectorAll<HTMLElement>('.cg-section[id]');
	const sidebarLinks = new Map<string, HTMLElement[]>();
	document.querySelectorAll<HTMLAnchorElement>('nav a[href*="#"]').forEach((a) => {
		const hash = a.href.split('#')[1];
		if (!hash) return;
		const list = sidebarLinks.get(hash) ?? [];
		list.push(a);
		sidebarLinks.set(hash, list);
	});

	if (sections.length && sidebarLinks.size) {
		const setActive = (id: string) => {
			sidebarLinks.forEach((links, hash) => {
				links.forEach((link) => link.classList.toggle('cg-sidebar-active', hash === id));
			});
		};

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
				if (visible) setActive(visible.target.id);
			},
			{ rootMargin: '-20% 0px -70% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
		);
		sections.forEach((section) => observer.observe(section));
	}
</script>
