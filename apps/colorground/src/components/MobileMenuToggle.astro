---
// 좌측 사이드바(=모바일에서는 상단 바)를 접고 펼치는 토글.
// 기본값은 CSS 미디어쿼리로만 정해진다: 모바일은 접힌 채, 데스크톱은 펼친 채.
// 그래서 JS가 늦게 붙어도(hydration 전) 처음부터 올바른 모습으로 렌더링된다.
// 이 버튼은 Starlight가 항상 .sidebar-pane 앞에 형제로 렌더링해 주는 자리를
// 그대로 이용하므로, 사이드바가 접혀 있어도(=display:none) 버튼은 계속 보인다.
---

<button type="button" id="cg-sidebar-toggle" class="cg-sidebar-toggle" aria-controls="starlight__sidebar" aria-label="목차 접기/펼치기">
	<span class="cg-toggle-mobile-bar">
		<span class="cg-toggle-label">목차</span>
		<span aria-hidden="true">›</span>
		<span id="cg-toggle-current">컬러그라운드</span>
		<svg class="cg-toggle-caret" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="0.9rem" height="0.9rem">
			<path d="M9 6l6 6-6 6" />
		</svg>
	</span>
	<svg class="cg-toggle-desktop-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="1rem" height="1rem">
		<path d="M15 6l-6 6 6 6" />
	</svg>
</button>

<script>
	const btn = document.getElementById('cg-sidebar-toggle');
	const html = document.documentElement;
	const desktopQuery = matchMedia('(min-width: 50rem)');

	function isExpanded(): boolean {
		return desktopQuery.matches
			? !html.classList.contains('cg-sidebar-collapsed')
			: html.classList.contains('cg-sidebar-expanded');
	}

	function applyState(expanded: boolean): void {
		if (desktopQuery.matches) {
			html.classList.toggle('cg-sidebar-collapsed', !expanded);
			html.classList.remove('cg-sidebar-expanded');
		} else {
			html.classList.toggle('cg-sidebar-expanded', expanded);
			html.classList.remove('cg-sidebar-collapsed');
		}
		btn?.setAttribute('aria-expanded', String(expanded));
	}

	if (btn) {
		applyState(isExpanded());

		btn.addEventListener('click', () => applyState(!isExpanded()));

		desktopQuery.addEventListener('change', () => {
			html.classList.remove('cg-sidebar-expanded', 'cg-sidebar-collapsed');
			applyState(isExpanded());
		});
	}
</script>

<style>
	.cg-sidebar-toggle {
		cursor: pointer;
		color: var(--sl-color-gray-2);
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-hairline);
	}

	.cg-sidebar-toggle:hover {
		color: var(--sl-color-text-accent);
	}

	@media (max-width: 49.9375rem) {
		.cg-sidebar-toggle {
			position: fixed;
			top: calc(var(--sl-nav-height) - 1px);
			inset-inline: 0;
			z-index: var(--sl-z-index-menu);
			display: flex;
			align-items: center;
			width: 100%;
			height: var(--sl-mobile-toc-height);
			padding: 0 1rem;
			border-radius: 0;
			border-inline: none;
			border-top: none;
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			font-size: var(--sl-text-xs);
			text-align: start;
		}

		.cg-toggle-mobile-bar {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			width: 100%;
		}

		.cg-toggle-label {
			color: var(--sl-color-gray-3);
		}

		#cg-toggle-current {
			color: var(--sl-color-white);
			font-weight: 600;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.cg-toggle-caret {
			margin-inline-start: auto;
			flex-shrink: 0;
			transition: transform 0.2s ease;
		}

		.cg-sidebar-toggle[aria-expanded='true'] .cg-toggle-caret {
			transform: rotate(90deg);
		}

		.cg-toggle-desktop-icon {
			display: none;
		}
	}

	@media (min-width: 50rem) {
		.cg-sidebar-toggle {
			position: fixed;
			top: calc(var(--sl-nav-height) + 0.75rem);
			inset-inline-start: 0.75rem;
			z-index: calc(var(--sl-z-index-navbar) + 1);
			display: flex;
			align-items: center;
			justify-content: center;
			width: 2.25rem;
			height: 2.25rem;
			border-radius: 50%;
			box-shadow: var(--sl-shadow-sm);
		}

		.cg-toggle-mobile-bar {
			display: none;
		}

		.cg-toggle-desktop-icon {
			transition: transform 0.2s ease;
		}

		.cg-sidebar-toggle[aria-expanded='false'] .cg-toggle-desktop-icon {
			transform: rotate(180deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cg-toggle-caret,
		.cg-toggle-desktop-icon {
			transition: none;
		}
	}
</style>
