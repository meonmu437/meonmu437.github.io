---
import FamilyWindow from '../components/FamilyWindow.astro';
import SaveWindow from '../components/SaveWindow.astro';
import CharacterWindow from '../components/CharacterWindow.astro';
import InventoryWindow from '../components/InventoryWindow.astro';
import SkillIcon from '../components/SkillIcon.astro';
import CampusMap from '../components/CampusMap.astro';
import InnMap from '../components/InnMap.astro';
import RoomMap from '../components/RoomMap.astro';
import PixelScene from '../components/PixelScene.astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
const stats=[['DEX','손재주',18],['IMG','상상력',20],['CHA','말주변',4],['BRV','용기',3]];
const traits=[['낯가림 Lv.MAX','첫 문장을 몇 번씩 연습하다가, 말을 걸 타이밍을 놓친다.'],['완벽주의','남들 눈에는 같은 것도 서너 번 다시 만든다. 건네지 못한 작은 동물만 늘어난다.'],['덕질 모드','좋아하는 이야기가 나오면 말이 길어진다. 혼자 떠들었다는 사실은 뒤늦게 깨닫는다.'],['자존감과 자존심은 별개','웬만한 일은 양보해도, 공들인 작업을 가볍게 여기는 말에는 물러서지 않는다.']];

---
<StarlightPage frontmatter={{title:'시라이시 유우키',description:'마지막 세이브 지점: 서울 — 조소과 너드의 미완료 첫사랑 퀘스트',tableOfContents:false}}>
<div class="my-content game-app">
 <section class="game-console" aria-label="유우키의 RPG 게임기" data-started="false">
  <div class="fullscreen-tools"><span id="fullscreen-hint" aria-live="polite"></span><div id="fullscreen-title-slot"><button type="button" id="toggle-fullscreen" aria-pressed="false">⛶ 전체화면</button></div></div>
  <div class="console-screen">
   <div id="title-screen" class="title-screen"><div class="title-logo"><div class="title-logo-stars" aria-hidden="true"><i>✦</i><i>✦</i><i>✧</i><i>✦</i><i>✧</i></div><h1 lang="ja"><span>まだ、</span><strong>渡せない想い</strong></h1><p class="title-korean"><span aria-hidden="true">~</span> 아직, 건네지 못한 마음 <span aria-hidden="true">~</span></p></div><button type="button" id="start-game"><span aria-hidden="true">▶</span> 이어하기</button></div>
   <div id="play-screen" class="play-screen" hidden>
    <header class="overworld-banner"><div class="overworld-left"><button type="button" class="game-save-button" data-open-screen="save" aria-haspopup="dialog">◆ 세이브</button></div><strong id="game-location">마지막 세이브 지점 · 서울</strong><div class="overworld-controls"><button type="button" id="return-scene" hidden>월드맵</button><div id="fullscreen-banner-slot"></div><button type="button" id="return-title" aria-label="타이틀 화면으로 돌아가기">TITLE</button></div></header>
    <div class="overworld-field"><div class="map-scene" data-scene="world"><PixelScene /></div><div class="map-scene" data-scene="campus" hidden><CampusMap /><div id="campus-effects" class="campus-effects" aria-hidden="true"></div></div><div class="map-scene" data-scene="inn" hidden><InnMap /></div><div class="map-scene" data-scene="rest" hidden><RoomMap /></div><aside class="hud-quest" aria-label="미완료 퀘스트"><button type="button" id="quest-toggle" aria-expanded="false" aria-controls="quest-content">미완료퀘스트 <span aria-hidden="true">＋</span></button><strong id="quest-content" hidden>아직도 좋아한다고 말하기</strong></aside></div>
    <section id="campaign-overlay" class="campaign-overlay" hidden aria-labelledby="campaign-heading" role="region"><div class="campaign-game-window"><header><strong id="campaign-heading">NEXT CAMPAIGN</strong><button type="button" id="close-campaign" aria-label="월드맵으로 돌아가기">돌아가기 ×</button></header><section id="campaign-panel" class="chapter ending love-campaign">
 <div class="campaign-heart" aria-hidden="true"><svg viewBox="0 0 16 16" shape-rendering="crispEdges"><path d="M2 2h4v2h4V2h4v2h2v6h-2v2h-2v2h-2v2H6v-2H4v-2H2v-2H0V4h2Z" fill="#db91a6"/><path d="M2 4h3v2H2z" fill="#ffe4c1"/></svg></div>
 <p class="eyebrow">NEXT CAMPAIGN</p><h2>사랑의 던전</h2><p>다시 만난 첫사랑.<br/>이번에는, 마음을 건넬 수 있을까?</p>
 <div class="campaign-routes" aria-label="다음 캠페인 선택">
 <a href="https://www.univers.chat/character/f8df5746-19d5-403d-8b2a-67e26ed181a1" target="_blank" rel="noopener noreferrer" class="campaign-route univers"><small>CAMPAIGN 01</small><strong>유니챗</strong><span>▶ 모험 시작</span></a>
 <button type="button" class="campaign-route" disabled><small>CAMPAIGN 02</small><strong>엘린</strong><span>준비 중</span></button>
 <button type="button" class="campaign-route" disabled><small>CAMPAIGN 03</small><strong>티팟</strong><span>준비 중</span></button>
 </div>
</section><footer>행선지를 선택하세요.<span>ESC · 월드맵</span></footer></div></section>
    <div class="battle-hud ornate-hud">
     <div class="hero-status"><button type="button" class="hero-badge" data-open-screen="sheet" aria-label="유우키 캐릭터 시트 열기"><svg viewBox="0 0 24 32" aria-hidden="true"><use href="#hero-sprite"/></svg></button><div class="hero-readout"><div class="hero-name"><strong>유우키 <small class="hero-level">Lv.20</small><small class="hero-job" aria-label="직업: 용사">용사</small></strong></div><div class="hero-gauges"><div class="ornate-gauge hp-gauge"><span>HP</span><i aria-label="HP 상태: 평온"><b></b></i><small>평온</small></div><div class="ornate-gauge mp-gauge"><span>MP</span><i aria-label="MP 상태: 상상력 MAX"><b></b></i><small>상상력 MAX</small></div></div><div class="hero-attributes" aria-label="능력치">{stats.map(([code,label,value])=><span><small>{label}</small><strong>{value}</strong></span>)}</div></div></div>
     <div class="hero-tools"><fieldset class="pixel-skill-box"><legend>스킬</legend><div>{traits.map(([title],i)=><button type="button" data-skill-index={i} aria-label={`${title} 스킬 카드 보기`} title={title} aria-haspopup="dialog"><SkillIcon index={i}/><span>{['낯가림','완벽주의','덕질 모드','자존심'][i]}</span></button>)}</div></fieldset><div class="hud-shortcuts"><button type="button" class="hud-inventory" data-open-screen="inventory" aria-haspopup="dialog"><span aria-hidden="true">▣</span> 인벤토리</button><button type="button" class="hud-character-open" data-open-screen="sheet" aria-haspopup="dialog"><span aria-hidden="true">♧</span> 캐릭터</button></div></div>
    </div>
    <section class="exploration-dialogue" id="exploration-dialogue" hidden aria-live="polite" aria-atomic="true"><header><strong id="explore-speaker">한국대학교</strong></header><p id="explore-text"></p><footer class="exploration-prompt"><button type="button" id="explore-action" hidden><span id="explore-action-label"></span><span class="prompt-arrow" aria-hidden="true">▼</span></button><span class="explore-caret" aria-hidden="true">▼</span></footer></section>
   </div>
  </div>
  <div class="console-label"><span>YUKI’S CAMPAIGN</span><span>WORLD 01 · SEOUL</span></div>

 <FamilyWindow />
 <InventoryWindow />
 <CharacterWindow />
 <SaveWindow />
 <dialog id="skill-dialog" aria-labelledby="skill-name" aria-describedby="skill-text"><article class="vintage-skill-card"><button type="button" id="close-skill" aria-label="스킬 카드 닫기">×</button><header><span>PASSIVE SKILL</span><span id="skill-card-index">01</span></header><div class="skill-card-art">{traits.map((_,i)=><div data-card-icon={i} hidden={i!==0}><SkillIcon index={i}/></div>)}<span class="card-star star-left" aria-hidden="true">✦</span><span class="card-star star-right" aria-hidden="true">✦</span></div><div class="skill-card-copy"><span class="skill-card-type">패시브 · 항상 발동</span><h2 id="skill-name"></h2><div class="skill-card-rule" aria-hidden="true">◆</div><p id="skill-text"></p></div><footer><span>판타지 연구회 ‘여관’</span><span aria-hidden="true">✧</span></footer></article></dialog>
 <dialog id="image-dialog" aria-label="이미지 확대"><button type="button" id="close-image" aria-label="이미지 닫기">닫기 ×</button><img id="large-image" alt=""/></dialog>
 </section>
</div>
<script src="/yuki/page.js" type="module" is:inline></script>
</StarlightPage>
