---
import {campusSites,campusRoadNodes,campusRoadEdges} from '../../public/exploration-data.js';
const trees=[[15,10],[110,20],[225,10],[382,8],[15,77],[223,57],[380,60],[225,119],[257,119],[379,117],[15,165],[245,180],[380,194],[243,224],[15,250],[100,260],[150,258],[252,260],[548,235],[578,200],[602,98],[603,166]];
---
<svg id="campus-map" class="exploration-map" viewBox="0 0 640 350" shape-rendering="crispEdges" role="group" aria-label="한국대학교 캠퍼스 탐험 지도" tabindex="0">
<defs><pattern id="campus-grass" width="20" height="16" patternUnits="userSpaceOnUse"><rect width="20" height="16" fill="#9bbb77"/><path d="M4 7h2V5h2v2h2m5 7h3v-1h2" fill="none" stroke="#b1cb87"/></pattern><pattern id="campus-paving" width="16" height="12" patternUnits="userSpaceOnUse"><rect width="16" height="12" fill="#d8cba0"/><path d="M0 11h16M8 0v11" fill="none" stroke="#c4b98f"/></pattern></defs>
<rect width="640" height="350" fill="url(#campus-grass)"/><rect y="303" width="640" height="47" fill="#d8d1aa"/>
<path d="M0 286h640v17H0z" fill="#6a7c76"/>
{campusRoadEdges.map(([from,to])=>{const a=campusRoadNodes[from],b=campusRoadNodes[to];return <path d={`M${a.x} ${a.y}L${b.x} ${b.y}`} stroke="url(#campus-paving)" stroke-width="12" fill="none"/>})}
<path d="M365 66h10m-10 7h10m-10 7h10m-10 7h10m-10 7h10m-10 7h10m-10 7h10" stroke="#929b77" stroke-width="2"/>
<path d="M305 287h7v15h-7zm13 0h7v15h-7zm13 0h7v15h-7z" fill="#ede8c4"/>
<path d="M9 282h286m55 0h245" stroke="#6c8262" stroke-width="4"/>
{trees.map(([x,y],i)=><g transform={`translate(${x} ${y})`} aria-hidden="true"><rect x="7" y="14" width="4" height="14" fill="#86784f"/><path d="M5 0h11v4h5v14h-5v4H0V6h5z" fill={i%3?'#63894d':'#b2ac58'}/><path d="M5 0h11v4H9v5H1V6h4z" fill={i%3?'#c0ce86':'#dfd47d'}/></g>)}
{campusSites.map(site=><g class="scene-object" data-inspect={site.id} data-owner="campus" role="button" tabindex="0" aria-label={`${site.name} 조사하기`}><title>{site.name}</title><rect class="scene-hit" x={site.x-6} y={site.y-11} width={site.w+12} height={site.h+28} fill="transparent"/>
 {site.kind==='building'&&<><rect x={site.x+3} y={site.y+5} width={site.w} height={site.h} fill="#788264"/><rect x={site.x} y={site.y} width={site.w} height={site.h} fill={site.color}/><path d={`M${site.x-4} ${site.y}h${site.w+8}v-6h-5v-5h-${site.w-2}v5h-7z`} fill={site.roof}/><path d={`M${site.x+3} ${site.y+2}h${site.w-6}`} stroke="#e5dab3" stroke-width="2"/>{Array.from({length:Math.max(2,Math.floor(site.w/17))},(_,j)=><rect x={site.x+7+j*16} y={site.y+10} width="8" height="9" fill={site.id==='business'?'#d1e6d2':'#e7d9a5'}/>)}<rect x={site.x+site.w/2-6} y={site.y+site.h-17} width="12" height="17" fill="#526b5a"/>{site.id==='hall'&&<text class="campus-entry-label" x={site.x+site.w/2} y={site.y+22} text-anchor="middle">여관 3F</text>}</>}
 {site.kind==='plaza'&&<><rect x={site.x} y={site.y+14} width={site.w} height="36" fill="#cfcb9c"/><rect x={site.x+29} y={site.y+13} width="8" height="28" fill="#8b7951"/><path d={`M${site.x+19} ${site.y}h29v5h10v18h-9v7h-34v-6h-8v-17h12z`} fill="#65894f"/><path d={`M${site.x+20} ${site.y+2}h25v5h-16v7h-17v-7h8z`} fill="#a9c47c"/><rect x={site.x+68} y={site.y+13} width="4" height="32" fill="#687d6b"/><rect x={site.x+63} y={site.y+9} width="14" height="14" fill="#e1d8b2" stroke="#70836b" stroke-width="2"/><path d={`M${site.x+70} ${site.y+12}v6h4`} fill="none" stroke="#6a7c64" stroke-width="2"/></>}
 {site.kind==='sports'&&<><rect x={site.x} y={site.y} width={site.w} height={site.h} rx="12" fill="#b49c73"/><rect x={site.x+8} y={site.y+7} width={site.w-16} height={site.h-14} rx="8" fill="#81a56d" stroke="#e3deb2" stroke-width="2"/><path d={`M${site.x+site.w/2} ${site.y+8}v${site.h-16}`} stroke="#e4dfb6" stroke-width="2"/><circle cx={site.x+site.w/2} cy={site.y+site.h/2} r="10" fill="none" stroke="#e4dfb6" stroke-width="2"/></>}
 {site.kind==='stage'&&<><rect x={site.x} y={site.y+8} width={site.w} height={site.h-8} fill="#947e5d"/><rect x={site.x+5} y={site.y+5} width={site.w-10} height="5" fill="#ddd1a0"/><path d={`M${site.x+3} ${site.y+8}v-15h${site.w-6}v15`} fill="none" stroke="#728461" stroke-width="3"/></>}
 {site.kind==='gate'&&<><path d={`M${site.x} ${site.y}h5v${site.h}h-5zm${site.w-5} 0h5v${site.h}h-5z`} fill="#9b9f7b"/><rect x={site.x} y={site.y} width={site.w} height="5" fill="#d1c699"/></>}
 {site.kind==='medical'&&<><rect x={site.x} y={site.y} width={site.w} height={site.h} fill="#c9d5bd"/><path d={`M${site.x+10} ${site.y+5}h3v12h-3zm-4 4h11v3h-11z`} fill="#aa7f6c"/><rect x={site.x+34} y={site.y+8} width="45" height="6" fill="#9bbdb4"/></>}
 <text class="scene-map-label" x={site.id==='dorm'?site.x-8:site.x+site.w/2} y={site.id==='dorm'?site.y+site.h/2+4:site.y+site.h+12} text-anchor={site.id==='dorm'?'end':'middle'}>{site.name}</text>
 </g>)}
<g id="campus-player" class="exploration-player" transform="translate(308 216)" pointer-events="none"><ellipse cx="12" cy="31" rx="10" ry="3" fill="#41594166"/><use href="#hero-sprite" width="24" height="32"/></g>
</svg>
