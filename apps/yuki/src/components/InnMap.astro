---
import {innObjects} from '../../public/exploration-data.js';
---
<svg id="inn-map" class="exploration-map" viewBox="0 0 640 320" shape-rendering="crispEdges" role="group" aria-label="판타지 연구회 여관 동아리방 탐험 지도" tabindex="0">
<defs><pattern id="inn-floor" width="48" height="24" patternUnits="userSpaceOnUse"><rect width="48" height="24" fill="#c1a572"/><path d="M0 23h48M24 0v23M4 5h12m15 11h10" fill="none" stroke="#aa8c60" stroke-width="1"/></pattern><pattern id="inn-wall" width="32" height="16" patternUnits="userSpaceOnUse"><rect width="32" height="16" fill="#b4ba92"/><path d="M0 15h32M16 0v15" fill="none" stroke="#939f7b"/></pattern></defs>
<rect width="640" height="320" fill="#4b5e50"/><rect x="12" y="9" width="616" height="300" fill="url(#inn-floor)"/>
<rect x="12" y="9" width="616" height="70" fill="url(#inn-wall)"/><path d="M12 79h616" stroke="#697a59" stroke-width="7"/><path d="M14 81v225h612V81" fill="none" stroke="#7c7754" stroke-width="7"/>
<path d="M169 202h28v20h-28zm247 0h28v20h-28zM219 207h21v14h-21zm39 0h21v14h-21zm62 0h21v14h-21zm38 0h21v14h-21z" fill="#8b815b"/><path d="M170 198h26v5h-26zm247 0h26v5h-26zM219 203h21v5h-21zm39 0h21v5h-21zm62 0h21v5h-21zm38 0h21v5h-21z" fill="#b9ba87"/>
<rect x="216" y="224" width="206" height="54" fill="#91976d"/><path d="M221 229h196v44H221z" fill="none" stroke="#c6c79a" stroke-width="2"/>
{innObjects.map(item=><g class="scene-object" data-inspect={item.id} data-owner="inn" role="button" tabindex="0" aria-label={`${item.name} 조사하기`}><title>{item.name}</title><rect class="scene-hit" x={item.x-5} y={item.y-5} width={item.w+10} height={item.h+12} fill="transparent"/>
 {['shelf','games'].includes(item.kind)&&<><rect x={item.x} y={item.y} width={item.w} height={item.h} fill="#7f7152"/><rect x={item.x+4} y={item.y+4} width={item.w-8} height={item.h-8} fill="#4b5b4c"/>{[0,1].map(row=><>{Array.from({length:Math.floor((item.w-12)/11)},(_,i)=><rect x={item.x+6+i*11} y={item.y+7+row*22} width={item.kind==='shelf'?7:9} height={item.kind==='shelf'?17:14} fill={['#c6bb86','#9aab91','#b08f76','#799496'][i%4]}/>)}<rect x={item.x+3} y={item.y+25+row*22} width={item.w-6} height="4" fill="#b29b6b"/></>)}</>}
 {item.kind==='board'&&<><rect x={item.x} y={item.y} width={item.w} height={item.h} fill="#e6e3bc" stroke="#798568" stroke-width="4"/><path d={`M${item.x+12} ${item.y+13}h45m12 0h29m-86 11h83m-83 11h57`} stroke="#7e9780" stroke-width="2"/><path d={`M${item.x+120} ${item.y+15}h18v15h-18z`} fill="none" stroke="#b69f77" stroke-width="2"/></>}
 {item.kind==='sofa'&&<><rect x={item.x} y={item.y+13} width={item.w} height={item.h-11} fill="#617e70"/><rect x={item.x+5} y={item.y} width={item.w-10} height="25" fill="#829e83"/><rect x={item.x+10} y={item.y+27} width={item.w-20} height="25" fill="#a0b393"/><path d={`M${item.x+item.w/2} ${item.y+28}v23`} stroke="#6c8a72" stroke-width="2"/><rect x={item.x} y={item.y+20} width="10" height="38" fill="#779781"/><rect x={item.x+item.w-10} y={item.y+20} width="10" height="38" fill="#779781"/></>}
 {item.kind==='blanket'&&<><rect x={item.x} y={item.y} width={item.w} height={item.h} fill="#c3b28d"/><path d={`M${item.x+5} ${item.y+2}v${item.h-4}m8 0v-${item.h-4}m8 0v${item.h-4}m8 0v-${item.h-4}`} stroke="#9a9f7a" stroke-width="3"/></>}
 {item.kind==='table'&&<><rect x={item.x+5} y={item.y+7} width={item.w} height={item.h} fill="#756b4f"/><rect x={item.x} y={item.y} width={item.w} height={item.h} fill="#b79762" stroke="#d1b67c" stroke-width="3"/><path d={`M${item.x+3} ${item.y+item.h/2}h${item.w-6}`} stroke="#a28356" stroke-width="2"/></>}
 {['book','zine'].includes(item.kind)&&<><rect x={item.x} y={item.y} width={item.w} height={item.h} fill={item.kind==='book'?'#8ba68e':'#b9b091'} stroke="#647a67" stroke-width="2"/><path d={`M${item.x+5} ${item.y+7}h${item.w-10}m0 6h-${item.w-10}`} stroke="#e0dfb4" stroke-width="2"/></>}
 {item.kind==='map'&&<><rect x={item.x} y={item.y} width={item.w} height={item.h} fill="#d8cca0"/><path d={`M${item.x+5} ${item.y+8}h13v11h17m-12-15v10h12`} stroke="#8d9e7b" stroke-width="2" fill="none"/><rect x={item.x+28} y={item.y+15} width="5" height="5" fill="#aa8065"/></>}
 {item.kind==='dice'&&<><rect x={item.x} y={item.y+3} width={item.w} height={item.h-3} fill="#8eada5"/><rect x={item.x-2} y={item.y} width={item.w+4} height="5" fill="#69867a"/><path d={`M${item.x+4} ${item.y+12}h8v8h-8zm12 7h7v7h-7z`} fill="#e4d8a4"/><path d={`M${item.x+7} ${item.y+14}h2v2h-2zm12 8h2v2h-2z`} fill="#7c8770"/></>}
 {item.kind==='snacks'&&<><rect x={item.x} y={item.y+8} width={item.w} height={item.h-8} fill="#877a55"/><rect x={item.x-2} y={item.y+4} width={item.w+4} height="8" fill="#b5a572"/><path d={`M${item.x+12} ${item.y-13}h19v23h-19z`} fill="#c9d0b4"/><path d={`M${item.x+16} ${item.y-21}h11v8h-11z`} fill="#9eae98"/><path d={`M${item.x+32} ${item.y-12}h7v17h-7`} fill="none" stroke="#718d7d" stroke-width="3"/><rect x={item.x+55} y={item.y-5} width="18" height="16" fill="#c4a878"/><rect x={item.x+77} y={item.y-9} width="19" height="20" fill="#9caa80"/></>}
 {item.kind==='miniature'&&<><rect x={item.x-6} y={item.y+3} width={item.w+12} height={item.h} fill="#ac9567"/><path d={`M${item.x+10} ${item.y-8}h5v10h8v-10h5v22h-4v6h-15v-6h-4v-12h5z`} fill="#d7d3ad"/><path d={`M${item.x+10} ${item.y+5}h3v3h-3zm12 0h3v3h-3z`} fill="#6b7f69"/></>}
 {item.kind==='npc'&&<g class="seungmin-sprite" aria-hidden="true" transform={`translate(${item.x} ${item.y})`}>
 <path d="M4 13h15v15H4z" fill="#25323b"/>
 <path d="M6 2h12v3h3v10H3V5h3z" fill="#202a33"/><path d="M7 3h10v3h3v7h-3v3H7v-3H4V6h3z" fill="#e0bea1"/>
 <path d="M6 2h12v3h3v4h-4V6H7v3H3V5h3z" fill="#1c242e"/><path d="M7 3h8v1H7z" fill="#4a5660"/>
 <path d="M6 8h5v5H6zm7 0h5v5h-5z" fill="#26333c"/><path d="M7 9h3v2H7zm7 0h3v2h-3z" fill="#b1c3b9"/><path d="M11 9h2v2h-2z" fill="#26333c"/>
 <path d="M7 16h11v10H7z" fill="#2a3740"/><path d="M8 17h2v6H8zm7 0h2v6h-2z" fill="#485760"/><path d="M11 17h1v5h-1zm3 0h1v5h-1z" fill="#a4b0a6"/>
 <path d="M7 26h4v4H7zm7 0h4v4h-4z" fill="#567187"/><path d="M7 29h4v3H5v-2h2zm7 0h4v1h2v2h-6z" fill="#37434b"/>
 <text class="npc-name-label" x="12" y="-5" text-anchor="middle">주인장</text>
 </g>}
 {item.kind==='door'&&<><rect x={item.x} y={item.y} width={item.w} height={item.h} fill="#7a7356"/><rect x={item.x+5} y={item.y+3} width={item.w-10} height={item.h-3} fill="#d1b682"/><path d={`M${item.x+5} ${item.y+5}h${item.w-10}`} stroke="#e7d6a1" stroke-width="2"/><text class="room-door-label" x={item.x+item.w/2} y={item.y+20} text-anchor="middle">나가기</text></>}
 </g>)}
<g id="inn-player" class="exploration-player" transform="translate(308 223)" pointer-events="none"><ellipse cx="12" cy="31" rx="10" ry="3" fill="#5a563b66"/><use href="#hero-sprite" width="24" height="32"/></g>
</svg>
