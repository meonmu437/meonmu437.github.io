const gridCols = Math.max(...regions.map((r) => r.col));
const gridRows = Math.max(...regions.map((r) => r.row));
---

<div class="nh-station-map-wrap">
	<div
		class="nh-station-map-scroll"
		style={`background-image: linear-gradient(color-mix(in srgb, var(--sl-color-bg) 45%, transparent), color-mix(in srgb, var(--sl-color-bg) 60%, transparent)), url(${europeMapSrc})`}
	>
		<div class="nh-station-map" style={`grid-template-columns: repeat(${gridCols}, minmax(3.4rem, 1fr)); grid-template-rows: repeat(${gridRows}, minmax(2.4rem, auto));`}>
			{regions.map((region) => (
				<button
					type="button"
					class="nh-station-tile"
					data-region={region.id}
					aria-expanded="false"
					style={`grid-column: ${region.col}; grid-row: ${region.row};`}
				>
					{region.tile}
				</button>
			))}
		</div>
	</div>

	<div class="nh-station-map-scrollbar" data-station-scrollbar hidden>
		<div class="nh-station-map-scrollbar-thumb" data-station-scrollbar-thumb></div>
	</div>

	<p class="nh-station-hint" data-station-hint>지역을 선택하면 주요 정거장 4곳이 펼쳐집니다. 같은 지역을 다시 누르면 접힙니다.</p>

	<div class="nh-station-panels">
		{regions.map((region) => (
			<div class="nh-station-panel" data-region-panel={region.id} hidden>
				<div class="nh-station-panel-header">
					<h4>{region.name}</h4>
					{region.warning && <p class="nh-station-warning">⚠ {region.warning}</p>}
				</div>
				<div class="nh-card-grid">
					{region.stations.map((station) => (
						<div class="nh-card">
							<p class="nh-card-title">{station.sid}</p>
							<p class="nh-card-meta">재앙 전 {station.city} · {station.nick}</p>
							<ul>
								<li><strong>분위기</strong> {station.mood}</li>
								<li><strong>대표자원</strong> {station.resource}</li>
								<li><strong>외부인 태도</strong> {station.attitude}</li>
							</ul>
						</div>
					))}
				</div>
			</div>
		))}
	</div>
</div>

<script>
	const tiles = document.querySelectorAll<HTMLButtonElement>('.nh-station-tile');
	const panels = document.querySelectorAll<HTMLDivElement>('[data-region-panel]');
	const hint = document.querySelector<HTMLParagraphElement>('[data-station-hint]');

	tiles.forEach((tile) => {
		tile.addEventListener('click', () => {
			const region = tile.dataset.region;
			const wasActive = tile.getAttribute('aria-expanded') === 'true';

			tiles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
			panels.forEach((p) => {
				p.hidden = true;
			});

			if (wasActive) {
				if (hint) hint.hidden = false;
				return;
			}

			tile.setAttribute('aria-expanded', 'true');
			const panel = document.querySelector<HTMLDivElement>(`[data-region-panel="${region}"]`);
			if (panel) {
				panel.hidden = false;
				if (hint) hint.hidden = true;
				panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}
		});
	});

	/*
	  모바일에서는 브라우저 기본 가로 스크롤바가 스크롤 중에만 잠깐 나타나거나
	  아예 안 보여서, 지도가 옆으로 더 있다는 걸 알아채기 어렵다. 스크롤
	  위치/비율을 직접 계산해 항상 보이는 막대로 그려준다.
	*/
	const scrollEl = document.querySelector<HTMLDivElement>('.nh-station-map-scroll');
	const scrollbarEl = document.querySelector<HTMLDivElement>('[data-station-scrollbar]');
	const thumbEl = document.querySelector<HTMLDivElement>('[data-station-scrollbar-thumb]');

	function updateScrollbar(): void {
		if (!scrollEl || !scrollbarEl || !thumbEl) return;
		const { scrollWidth, clientWidth, scrollLeft } = scrollEl;
		const scrollable = scrollWidth > clientWidth + 1;
		scrollbarEl.hidden = !scrollable;
		if (!scrollable) return;

		const thumbRatio = clientWidth / scrollWidth;
		const maxScrollLeft = scrollWidth - clientWidth;
		const progress = maxScrollLeft > 0 ? scrollLeft / maxScrollLeft : 0;
		thumbEl.style.width = `${thumbRatio * 100}%`;
		thumbEl.style.transform = `translateX(${progress * (100 / thumbRatio - 100)}%)`;
	}

	scrollEl?.addEventListener('scroll', updateScrollbar, { passive: true });
	window.addEventListener('resize', updateScrollbar);
	updateScrollbar();

	/* 앰버 막대 자체를 클릭/드래그해서도 지도를 옆으로 넘길 수 있게 한다 */
	function scrollLeftForClientX(clientX: number): number {
		if (!scrollEl || !scrollbarEl || !thumbEl) return 0;
		const trackRect = scrollbarEl.getBoundingClientRect();
		const thumbWidth = thumbEl.getBoundingClientRect().width;
		const usableTrack = trackRect.width - thumbWidth;
		const maxScrollLeft = scrollEl.scrollWidth - scrollEl.clientWidth;
		if (usableTrack <= 0 || maxScrollLeft <= 0) return 0;
		const offsetX = clientX - trackRect.left - thumbWidth / 2;
		const ratio = Math.min(1, Math.max(0, offsetX / usableTrack));
		return ratio * maxScrollLeft;
	}

	let draggingScrollbar = false;

	scrollbarEl?.addEventListener('pointerdown', (e) => {
		if (!scrollEl) return;
		draggingScrollbar = true;
		scrollbarEl.setPointerCapture(e.pointerId);
		scrollbarEl.classList.add('is-dragging');
		scrollEl.scrollLeft = scrollLeftForClientX(e.clientX);
	});

	scrollbarEl?.addEventListener('pointermove', (e) => {
		if (!draggingScrollbar || !scrollEl) return;
		scrollEl.scrollLeft = scrollLeftForClientX(e.clientX);
	});

	function endScrollbarDrag(e: PointerEvent): void {
		if (!draggingScrollbar) return;
		draggingScrollbar = false;
		scrollbarEl?.releasePointerCapture(e.pointerId);
		scrollbarEl?.classList.remove('is-dragging');
	}

	scrollbarEl?.addEventListener('pointerup', endScrollbarDrag);
	scrollbarEl?.addEventListener('pointercancel', endScrollbarDrag);
</script>

<style>
	.nh-station-map-wrap {
		margin: 1.75rem 0;
	}

	/*
	  유럽 야간 지도는 이 박스(타일 그리드만 담는 고정 크기 영역)에만 건다.
	  아래 지역 패널이 펼쳐져도 이 박스 자체의 높이는 그대로라서, 배경이 늘어나며
	  깨지는 문제 없이 항상 같은 비율로 유지된다.
	*/
	.nh-station-map-scroll {
		overflow-x: auto;
		padding: 0.5rem 0.5rem 0.9rem;
		margin-inline: -0.5rem;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		/* 네이티브 스크롤바는 숨기고, 아래 커스텀 앰버 막대만 보이게 한다 */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.nh-station-map-scroll::-webkit-scrollbar {
		display: none;
	}

	/*
	  모바일에서 네이티브 스크롤바가 안 보이거나 스크롤 중에만 잠깐 나타나는
	  문제 때문에, 스크롤 가능 여부/위치를 직접 그려서 항상 보이게 한다.
	  가로로 다 들어가서 스크롤이 필요 없는 폭(주로 데스크톱)에서는 JS가
	  hidden 속성을 붙여 감춘다.
	*/
	.nh-station-map-scrollbar {
		position: relative;
		height: 0.5rem;
		margin: 0.6rem 0.5rem 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
		cursor: pointer;
		touch-action: none;
	}

	.nh-station-map-scrollbar[hidden] {
		display: none;
	}

	.nh-station-map-scrollbar-thumb {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		border-radius: 999px;
		background: var(--sl-color-accent);
		pointer-events: none;
	}

	.nh-station-map-scrollbar.is-dragging .nh-station-map-scrollbar-thumb {
		background: var(--sl-color-accent-high);
	}

	.nh-station-map {
		position: relative;
		display: grid;
		gap: 0.4rem;
	}

	.nh-station-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 3.4rem;
		padding: 0.5rem 0.4rem;
		border-radius: 0.3rem;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
		background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
		font-family: var(--nh-font-display);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--sl-color-gray-1);
		cursor: pointer;
		transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
	}

	.nh-station-tile:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-1px);
	}

	.nh-station-tile[aria-expanded='true'] {
		background: color-mix(in srgb, var(--sl-color-accent) 32%, transparent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
		box-shadow: 0 0 0.6rem color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
	}

	@media (prefers-reduced-motion: reduce) {
		.nh-station-tile {
			transition: none;
		}
	}

	.nh-station-hint {
		margin: 0.5rem 0 0;
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.nh-station-hint[hidden] {
		display: none;
	}

	.nh-station-panel {
		margin-top: 1.5rem;
	}

	.nh-station-panel-header {
		text-align: center;
		margin-bottom: 1rem;
	}

	.nh-station-panel-header h4 {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-family: var(--nh-font-display);
		color: var(--sl-color-accent-high);
	}

	.nh-station-warning {
		display: inline-block;
		margin: 0.6rem auto 0;
		padding: 0.3rem 0.75rem;
		border-radius: 0.25rem;
		font-family: var(--nh-font-display);
		font-size: var(--sl-text-xs);
		color: hsl(355, 85%, 82%);
		background: color-mix(in srgb, hsl(355, 75%, 50%) 16%, transparent);
		border: 1px solid color-mix(in srgb, hsl(355, 75%, 55%) 40%, transparent);
	}
</style>
