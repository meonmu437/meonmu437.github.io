---
// 페이지 최상단, 어떤 .jl-section보다도 앞. 스크롤 리빌이 아니라 "영화
// 예고편"처럼 페이지에 들어오자마자 재생되는 한 번짜리 시퀀스다 — 짧은
// 내레이션 카드가 순서대로 나타났다 사라지고, 마지막 "본격 언더커버
// 언더커버 로맨스" 도장 카드에서 멈춘다.
// prefers-reduced-motion: reduce에서는 애니메이션 없이 전체 대사를
// 그대로 세로로 쌓아 보여준다(정보 손실 없음).
const beats: { en: string; ko: string; size: 'sm' | 'lg' }[] = [
	{ en: 'Rainbow Village, Virginia.', ko: '미국 버지니아 주, 레인보우 빌리지.', size: 'sm' },
	{ en: 'Another perfectly ordinary day.', ko: '오늘도, 별일은 없다.', size: 'sm' },
	{ en: 'The manager is looking for Julian, schedule in hand.', ko: '레인보우 마트 점장은 근무표를 들고 줄리안을 찾고 있고,', size: 'sm' },
	{ en: 'Checkout Six has a slightly longer line. Again.', ko: '6번 계산대엔 오늘도 사람이 조금 더 많다.', size: 'sm' },
	{ en: 'Someone started a new rumor at the Bluebell Diner.', ko: '블루벨 다이너에서는 누군가 새로운 소문을 시작했다.', size: 'sm' },
	{ en: 'And somewhere in that ordinary life...', ko: '그리고 그 모든 평범한 일상 어딘가에,', size: 'sm' },
	{ en: 'Someone is lying.', ko: '누군가는, 거짓말을 하고 있다.', size: 'lg' },
];
const stamp = { en: 'An Undercover Romance', ko: '본격 언더커버 로맨스', noteEn: 'Comedy at your discretion', noteKo: '코미디는 각자 재량' };
const BEAT_DURATION = 1.6;
---

<div class="jl-trailer">
	<div class="jl-trailer-bar jl-trailer-bar-top" aria-hidden="true"></div>
	<div class="jl-trailer-bar jl-trailer-bar-bottom" aria-hidden="true"></div>

	<div class="jl-trailer-stage" aria-hidden="true">
		{
			beats.map((beat, i) => (
				<p class={`jl-trailer-beat jl-trailer-beat-${beat.size}`} style={`--jl-i: ${i}`}>
					<span class="jl-trailer-en" aria-label={beat.en}>
						{beat.en.split(' ').map((word) => <span class="jl-collage-word" aria-hidden="true">{word}</span>)}
					</span>
					<span class="jl-trailer-ko">{beat.ko}</span>
				</p>
			))
		}
		<p class="jl-trailer-stamp" style={`--jl-i: ${beats.length}`}>
			<span class="jl-trailer-en" aria-label={stamp.en}>
				{stamp.en.split(' ').map((word) => <span class="jl-collage-word" aria-hidden="true">{word}</span>)}
			</span>
			<span class="jl-trailer-ko">{stamp.ko}</span>
			<small class="jl-trailer-note"><span>{stamp.noteEn}</span><span>{stamp.noteKo}</span></small>
		</p>
	</div>

	<div class="jl-trailer-static">
		{beats.map((beat) => <p><span class="jl-trailer-en" aria-label={beat.en}>{beat.en.split(' ').map((word) => <span class="jl-collage-word" aria-hidden="true">{word}</span>)}</span><span class="jl-trailer-ko">{beat.ko}</span></p>)}
		<p class="jl-trailer-static-stamp"><span class="jl-trailer-en" aria-label={stamp.en}>{stamp.en.split(' ').map((word) => <span class="jl-collage-word" aria-hidden="true">{word}</span>)}</span><span class="jl-trailer-ko">{stamp.ko}</span><small class="jl-trailer-note"><span>{stamp.noteEn}</span><span>{stamp.noteKo}</span></small></p>
	</div>
</div>

<style define:vars={{ beatDuration: `${BEAT_DURATION}s` }}>
	.jl-trailer {
		position: relative;
		overflow: hidden;
		margin-inline: calc(-1 * var(--sl-content-pad-x));
		background: #05060a;
	}

	.jl-trailer-bar {
		position: absolute;
		left: 0;
		right: 0;
		height: clamp(0.9rem, 3.2vw, 2.1rem);
		background: #000;
		z-index: 2;
	}
	.jl-trailer-bar-top {
		top: 0;
	}
	.jl-trailer-bar-bottom {
		bottom: 0;
	}

	.jl-trailer-stage {
		position: relative;
		height: clamp(16rem, 32vw, 22rem);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(2.5rem, 7vw, 4rem) 1.5rem;
	}

	.jl-trailer-beat,
	.jl-trailer-stamp {
		position: absolute;
		inset-inline: 1.5rem;
		margin: 0;
		text-align: center;
		opacity: 0;
		color: #f4f1ea;
	}

	.jl-trailer-en,
	.jl-trailer-ko {
		display: block;
	}

	.jl-trailer-en {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.12em 0.18em;
		line-height: 1.05;
	}

	.jl-collage-word {
		display: inline-block;
		padding: 0.09em 0.2em 0.13em;
		background: #fff4a8;
		box-shadow: 0.08em 0.1em 0 rgba(0, 0, 0, 0.28);
		font-family: 'Archivo Black', sans-serif;
		font-size: 0.82em;
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.01em;
		color: #172653;
		transform: rotate(-1.5deg);
	}
	.jl-collage-word:nth-child(4n + 2) {
		background: #ff91ae;
		font-family: 'Bebas Neue', sans-serif;
		font-size: 1em;
		color: #401229;
		transform: rotate(1.8deg);
	}
	.jl-collage-word:nth-child(4n + 3) {
		background: #79d8ef;
		font-family: 'Playfair Display', serif;
		font-size: 0.88em;
		color: #102f53;
		transform: rotate(-0.8deg);
	}
	.jl-collage-word:nth-child(4n) {
		background: #a8e887;
		font-family: 'Bungee', sans-serif;
		font-size: 0.72em;
		color: #183815;
		transform: rotate(1deg);
	}

	.jl-trailer-ko {
		width: fit-content;
		max-width: 100%;
		margin: 0.8rem auto 0;
		padding: 0.18rem 0.45rem 0.22rem;
		background: rgba(0, 0, 0, 0.72);
		font-family: 'Archivo', 'Noto Sans KR', sans-serif;
		font-size: clamp(0.72rem, 1.6vw, 0.9rem);
		font-weight: 500;
		line-height: 1.45;
		color: #f5f4f0;
		word-break: keep-all;
	}

	.jl-trailer-beat-sm {
		font-size: clamp(1.35rem, 3.8vw, 2.3rem);
	}

	.jl-trailer-beat-lg {
		font-size: clamp(2rem, 6vw, 3.6rem);
		color: #fff;
	}

	.jl-trailer-stamp {
		width: fit-content;
		margin-inline: auto;
		padding: 0.75rem 1.3rem 0.85rem;
		font-size: clamp(1.15rem, 4vw, 1.8rem);
	}
	.jl-trailer-stamp .jl-collage-word:nth-child(1) { background: #ff6f91; }
	.jl-trailer-stamp .jl-collage-word:nth-child(2) { background: #ffbd59; }
	.jl-trailer-stamp .jl-collage-word:nth-child(3) { background: #fff06a; }
	.jl-trailer-stamp .jl-collage-word:nth-child(4) { background: #74dc8b; }
	.jl-trailer-stamp .jl-trailer-ko {
		margin-top: 0.9rem;
		font-size: clamp(1rem, 2.5vw, 1.35rem);
		background: linear-gradient(90deg, #ff789a, #ffbd59, #fff06a, #79dda0, #72cbe9, #b99aef);
		box-shadow: 0 0.35rem 1.2rem rgba(121, 203, 233, 0.2);
		font-weight: 700;
		color: #17213c;
	}
	.jl-trailer-note {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.55rem;
		width: fit-content;
		margin: 0.5rem auto 0;
		color: rgba(255, 246, 218, 0.88);
		transform: rotate(-2.2deg);
	}
	.jl-trailer-note span:first-child {
		font-family: 'Pacifico', cursive;
		font-size: clamp(0.65rem, 1.5vw, 0.82rem);
	}
	.jl-trailer-note span:last-child {
		font-family: 'Gaegu', 'Noto Sans KR', cursive;
		font-size: clamp(0.8rem, 1.9vw, 1rem);
		font-weight: 700;
	}

	.jl-trailer-static {
		display: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.jl-trailer-beat {
			animation-name: jl-beat-cycle;
			animation-duration: var(--beatDuration);
			animation-timing-function: ease-in-out;
			animation-fill-mode: both;
			animation-delay: calc(var(--jl-i) * var(--beatDuration));
		}
		.jl-trailer-stamp {
			animation-name: jl-beat-settle;
			animation-duration: calc(var(--beatDuration) * 1.15);
			animation-timing-function: ease-out;
			animation-fill-mode: both;
			animation-delay: calc(var(--jl-i) * var(--beatDuration));
		}
	}

	@keyframes jl-beat-cycle {
		0% {
			opacity: 0;
			transform: translateY(6px);
		}
		14% {
			opacity: 1;
			transform: translateY(0);
		}
		78% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes jl-beat-settle {
		0% {
			opacity: 0;
			transform: scale(0.94);
		}
		35% {
			opacity: 1;
			transform: scale(1);
		}
		100% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.jl-trailer-stage {
			display: none;
		}
		.jl-trailer-static {
			display: block;
			padding: clamp(2rem, 6vw, 3rem) 1.5rem;
			text-align: center;
			color: #f4f1ea;
			font-family: 'Noto Sans KR', sans-serif;
		}
		.jl-trailer-static p {
			margin: 0 0 0.7rem;
			font-size: 1rem;
			line-height: 1.6;
		}
		.jl-trailer-static .jl-trailer-en {
			font-size: 1.25rem;
		}
		.jl-trailer-static .jl-trailer-ko {
			margin-top: 0.35rem;
		}
		.jl-trailer-static-stamp {
			display: inline-block;
			margin-top: 0.6rem;
			padding: 0.5rem 1.2rem;
			font-size: 1.1rem;
		}
	}
</style>
