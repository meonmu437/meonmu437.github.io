<div class="jl-record-warning" hidden role="alertdialog" aria-modal="true" aria-labelledby="jl-record-warning-title" aria-describedby="jl-record-warning-message">
	<div class="jl-record-warning-card">
		<span class="jl-record-warning-tape">REGISTER 06 · MISSCAN ALERT</span>
		<span class="jl-record-warning-icon" aria-hidden="true">⚠</span>
		<p class="jl-record-warning-code">ITEM NOT FOUND · JV-031</p>
		<p class="jl-record-warning-title" id="jl-record-warning-title">아, 이쪽은 직원 기록이 아닙니다.</p>
		<p class="jl-record-warning-message" id="jl-record-warning-message">1+1 상품에 다른 기록이 섞여 있습니다.<br />정말 하나 더 확인하시겠어요?</p>
		<button type="button" class="jl-record-warning-confirm">그래도 하나 더 받기</button>
	</div>
</div>

<script>
	const receipt = document.querySelector<HTMLElement>('.jl-flip-receipt');
	const buttons = document.querySelectorAll<HTMLButtonElement>('.jl-receipt-fold');
	const content = document.getElementById('jl-classified-content');
	const warning = document.querySelector<HTMLElement>('.jl-record-warning');
	const warningConfirm = warning?.querySelector<HTMLButtonElement>('.jl-record-warning-confirm');
	let hasShownRecordWarning = false;
	let warningTrigger: HTMLButtonElement | null = null;

	function setRevealed(revealed: boolean) {
		if (!receipt || !content) return;
		receipt.classList.toggle('is-flipped', revealed);
		buttons.forEach((button) => button.setAttribute('aria-expanded', String(revealed)));
		content.hidden = !revealed;
		document.documentElement.classList.toggle('jl-classified-open', revealed);
		document.documentElement.dataset.theme = revealed ? 'dark' : 'light';
		window.dispatchEvent(new Event('resize'));
	}

	buttons.forEach((button) => button.addEventListener('click', () => {
		const willReveal = !receipt?.classList.contains('is-flipped');
		if (willReveal && !hasShownRecordWarning) {
			hasShownRecordWarning = true;
			warningTrigger = button;
			if (warning) {
				warning.hidden = false;
				requestAnimationFrame(() => warning.classList.add('is-open'));
				warningConfirm?.focus();
			}
			return;
		}
		setRevealed(willReveal);
	}));

	function closeWarning(reveal = false) {
		if (!warning) return;
		warning.classList.remove('is-open');
		warning.hidden = true;
		if (reveal) setRevealed(true);
		else warningTrigger?.focus();
	}

	warningConfirm?.addEventListener('click', () => closeWarning(true));
	warning?.addEventListener('click', (event) => {
		if (event.target === warning) closeWarning();
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && warning && !warning.hidden) closeWarning();
	});

	function revealForHash() {
		if (location.hash && content?.querySelector(location.hash)) setRevealed(true);
	}

	revealForHash();
	document.documentElement.classList.add('jl-receipt-theme');
	window.addEventListener('hashchange', revealForHash);
</script>

