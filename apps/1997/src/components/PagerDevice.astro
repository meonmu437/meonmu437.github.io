---
// 마무리 섹션: 실제 삐삐(무선호출기) 단말기 모양의 정적 컴포넌트.
// 여러 메시지를 넘겨보는 상호작용은 없고, 마지막 한 줄만 LCD 화면에 띄운다.
// 카세트와 마찬가지로 몸체 색은 테마와 무관하게 고정(물건이라는 감각 유지).
interface Props {
	message: string;
	universLink?: string;
	elynLink?: string;
}

const { message, universLink, elynLink } = Astro.props;
---

<div class="ss-pager">
	<div class="ss-pager-clip" aria-hidden="true">
		<span></span>
	</div>

	<div class="ss-pager-body">
		<div class="ss-pager-screws" aria-hidden="true">
			<span></span><span></span><span></span><span></span>
		</div>

		<header class="ss-pager-header">
			<div class="ss-pager-name-row">
				<span class="ss-pager-name">삐삐통신</span>
				<span class="ss-pager-badge">97</span>
			</div>
			<div class="ss-pager-antenna" aria-hidden="true">
				{Array.from({ length: 18 }).map(() => (
					<span></span>
				))}
			</div>
		</header>

		<div class="ss-pager-lcd-bezel">
			<div class="ss-pager-lcd">
				<div class="ss-pager-lcd-status">
					<span class="ss-pager-battery" aria-hidden="true"><span></span></span>
					<span class="ss-pager-statuslabel">새 문자</span>
					<span class="ss-pager-signal" aria-hidden="true">
						<span></span><span></span><span></span><span></span>
					</span>
					<span class="ss-pager-count">미확인 01 · 문자 01/01</span>
				</div>

				<div class="ss-pager-sender-row">
					<span>보낸 사람 · 성민</span>
					<span>1997-05-20 화 14:30</span>
				</div>

				<div class="ss-pager-message">
					<div class="ss-pager-message-head">
						<span>수신 메시지</span>
						<span class="ss-pager-pulse">삐삐! 삐삐!</span>
					</div>
					<div class="ss-pager-message-body">
						<span class="ss-pager-arrow" aria-hidden="true">▶</span>
						<p>{message}<span class="ss-pager-cursor" aria-hidden="true"></span></p>
					</div>
				</div>

				<div class="ss-pager-dots" aria-hidden="true">
					<span class="ss-pager-dot ss-pager-dot--current"></span>
				</div>
			</div>
		</div>

		{(universLink || elynLink) && (
			<div class="ss-pager-links">
				{universLink && (
					<a href={universLink} target="_blank" rel="noopener noreferrer" class="ss-pager-link ss-pager-link--univers">
						유니챗 ↗
					</a>
				)}
				{elynLink && (
					<a href={elynLink} target="_blank" rel="noopener noreferrer" class="ss-pager-link ss-pager-link--elyn">
						엘린 ↗
					</a>
				)}
			</div>
		)}

		<p class="ss-pager-footer">서울 · 1997</p>
	</div>
</div>

<style>
	.ss-pager {
		position: relative;
		margin: 0 auto;
		max-width: 24rem;
	}

	.ss-pager-clip {
		position: absolute;
		top: -1.4rem;
		right: 2rem;
		width: 5rem;
		height: 1.9rem;
		border-radius: 0.6rem 0.6rem 0 0;
		background: #15191b;
		border: 2px solid #090c0d;
		border-bottom: none;
	}

	.ss-pager-clip span {
		display: block;
		margin: 0.5rem auto 0;
		width: 2.6rem;
		height: 0.3rem;
		border-radius: 999px;
		background: #080a0b;
	}

	.ss-pager-body {
		position: relative;
		padding: 1.1rem 1.2rem 1.3rem;
		border-radius: 1.3rem 1.3rem 1.7rem 1.7rem;
		background: linear-gradient(165deg, #262b2e, #171b1d);
		border: 1.5px solid #090c0d;
		box-shadow: 0 1.2rem 2.5rem rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.ss-pager-screws span {
		position: absolute;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: #0c0f10;
		box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.6);
	}
	.ss-pager-screws span:nth-child(1) {
		top: 0.6rem;
		left: 0.6rem;
	}
	.ss-pager-screws span:nth-child(2) {
		top: 0.6rem;
		right: 0.6rem;
	}
	.ss-pager-screws span:nth-child(3) {
		bottom: 0.7rem;
		left: 0.6rem;
	}
	.ss-pager-screws span:nth-child(4) {
		bottom: 0.7rem;
		right: 0.6rem;
	}

	.ss-pager-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.2rem 0.3rem 0.7rem;
	}

	.ss-pager-name-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.ss-pager-name {
		font-family: var(--ss-font-display);
		font-style: italic;
		font-weight: 700;
		font-size: var(--sl-text-sm);
		letter-spacing: 0.1em;
		color: #c6c9c6;
	}

	.ss-pager-badge {
		padding: 0.05rem 0.4rem;
		border-radius: 999px;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: #e6bbb4;
		background: #ae2e29;
		border: 1px solid #7f2422;
	}

	.ss-pager-antenna {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 0.15rem;
		padding: 0.3rem;
		border-radius: 0.35rem;
		background: #15191b;
		border: 1px solid rgba(0, 0, 0, 0.5);
	}

	.ss-pager-antenna span {
		width: 0.18rem;
		height: 0.18rem;
		border-radius: 50%;
		background: #050707;
	}

	.ss-pager-lcd-bezel {
		border-radius: 0.6rem;
		border: 2.5px solid #07090a;
		background: #0b0e0f;
		padding: 0.4rem;
		box-shadow: inset 0 3px 10px rgba(0, 0, 0, 0.9);
	}

	.ss-pager-lcd {
		border-radius: 0.3rem;
		border: 1px solid #687b58;
		background: linear-gradient(175deg, #b0c07f, #9cab6d);
		padding: 0.75rem 0.85rem 0.9rem;
		color: #17231a;
	}

	.ss-pager-lcd-status {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid #344b36;
	}

	.ss-pager-battery {
		display: inline-flex;
		align-items: center;
	}

	.ss-pager-battery span {
		display: block;
		width: 0.9rem;
		height: 0.55rem;
		border: 1px solid #263a29;
	}

	/* batteryLevel 3/4 기본값과 동일 */
	.ss-pager-battery span::after {
		content: '';
		display: block;
		width: 75%;
		height: 100%;
		background: #263a29;
	}

	.ss-pager-signal {
		display: inline-flex;
		align-items: flex-end;
		gap: 0.12rem;
	}

	.ss-pager-signal span {
		width: 0.15rem;
		background: #263a29;
	}
	.ss-pager-signal span:nth-child(1) {
		height: 0.25rem;
	}
	.ss-pager-signal span:nth-child(2) {
		height: 0.4rem;
	}
	.ss-pager-signal span:nth-child(3) {
		height: 0.55rem;
	}
	/* signalLevel 3/4 기본값과 동일 — 마지막 막대만 희미하게 */
	.ss-pager-signal span:nth-child(4) {
		height: 0.7rem;
		opacity: 0.3;
	}

	.ss-pager-statuslabel {
		font-family: var(--ss-font-display);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.ss-pager-count {
		margin-inline-start: auto;
		flex-shrink: 0;
		font-family: var(--ss-font-display);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.ss-pager-sender-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.6rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px dashed #4f684f;
		font-family: var(--ss-font-display);
		font-size: 0.68rem;
		font-weight: 700;
	}

	.ss-pager-message {
		margin-top: 0.7rem;
		padding: 0.7rem 0.9rem 0.8rem;
		border-radius: 0.15rem;
		background: #243426;
		box-shadow: inset 3px 0 0 #17231a, inset -3px 0 0 #17231a;
		color: #c3d497;
	}

	.ss-pager-message-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid #728657;
		font-family: var(--ss-font-display);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: #9caf72;
	}

	.ss-pager-pulse {
		color: #c9d99f;
		animation: ss-pulse 1.4s ease-in-out infinite;
	}

	@keyframes ss-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.4;
		}
	}

	.ss-pager-message-body {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.ss-pager-arrow {
		flex-shrink: 0;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.ss-pager-message p {
		margin: 0;
		font-family: var(--ss-font-display);
		font-size: var(--sl-text-sm);
		line-height: 1.75;
	}

	.ss-pager-cursor {
		display: inline-block;
		width: 0.5rem;
		height: 1em;
		margin-inline-start: 0.2rem;
		background: #b7ca8b;
		vertical-align: text-bottom;
		animation: ss-blink 1s step-end infinite;
	}

	.ss-pager-dots {
		display: flex;
		justify-content: center;
		gap: 0.3rem;
		margin-top: 0.6rem;
	}

	.ss-pager-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 0.1rem;
		border: 1px solid #344b36;
		background: transparent;
	}

	.ss-pager-dot--current {
		background: #263a29;
	}

	/* 저장된 번호 두 개를 누르는 단축 다이얼 버튼처럼 */
	.ss-pager-links {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.7rem;
	}

	.ss-pager-link {
		flex: 1;
		text-align: center;
		padding: 0.45rem 0.5rem;
		border-radius: 0.5rem;
		font-family: var(--ss-font-display);
		font-weight: 700;
		font-size: var(--sl-text-xs);
		text-decoration: none;
		background: #15191b;
		border: 1px solid #090c0d;
		box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.05);
		transition: transform 0.15s ease, filter 0.15s ease;
	}

	.ss-pager-link:hover {
		filter: brightness(1.2);
		transform: translateY(-1px);
	}

	.ss-pager-link:active {
		transform: translateY(0);
	}

	.ss-pager-link--univers {
		color: hsl(330, 80%, 72%);
	}

	.ss-pager-link--elyn {
		color: hsl(258, 70%, 76%);
	}

	.ss-pager-footer {
		margin: 0.6rem 0 0;
		text-align: center;
		font-family: var(--ss-font-display);
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		color: #626967;
	}

	@media (prefers-reduced-motion: reduce) {
		.ss-pager-cursor,
		.ss-pager-pulse {
			animation: none;
		}
	}
</style>
