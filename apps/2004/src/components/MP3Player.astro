---
// 히어로 인트로: 1997의 카세트 플레이어 자리를 대신하는 2004년식 MP3 플레이어.
// 실제 물건(브러시드 메탈 바디)이라는 감각을 살리기 위해 셸 색상은
// 라이트/다크 테마와 무관하게 고정된 값을 쓴다.
// 화면에 들어오면 화면이 켜지고 이퀄라이저가 움직이기 시작하다가, 잠시 뒤
// revealTarget으로 지정한 엘리먼트에 y04-show 클래스를 붙여 뒤이어 나올
// 내용(재생 중 이야기)을 페이드인한다.
interface Props {
	tagline: string;
	trackNo?: string;
	revealTarget?: string;
}

const { tagline, trackNo = '07', revealTarget } = Astro.props;
---

<div class="y04-mp3" data-reveal-target={revealTarget}>
	<div class="y04-mp3-body">
		<div class="y04-mp3-screen-bezel">
			<div class="y04-mp3-screen">
				<div class="y04-mp3-screen-top">
					<span class="y04-mp3-signal" aria-label="통신 신호 최대" title="통신 신호 최대">
						<span></span><span></span><span></span><span></span><span></span>
					</span>
					<span class="y04-mp3-screen-battery" aria-hidden="true"><span></span></span>
				</div>

				<div class="y04-mp3-eq" aria-hidden="true">
					<span></span><span></span><span></span><span></span><span></span><span></span><span></span>
				</div>

				<div class="y04-mp3-tagline">
					<span class="y04-mp3-tagline-track">{tagline}</span>
				</div>

				<div class="y04-mp3-screen-bottom">
					<span class="y04-mp3-track" data-track>TRACK {trackNo}</span>
					<span class="y04-mp3-status" data-status>PAUSE</span>
				</div>
			</div>
		</div>

		<div class="y04-mp3-controls" aria-hidden="true">
			<button class="y04-mp3-btn y04-mp3-btn-prev" type="button" tabindex="-1"><span>◀◀</span></button>
			<button class="y04-mp3-btn y04-mp3-btn-play" type="button" tabindex="-1"><span>▶</span></button>
			<button class="y04-mp3-btn y04-mp3-btn-next" type="button" tabindex="-1"><span>▶▶</span></button>
		</div>

		<p class="y04-mp3-spec" aria-hidden="true">256MB · MP3 / WMA</p>
	</div>

	<p class="y04-mp3-caption">
		<span class="y04-mp3-time" data-time>00:00</span>
		<span data-caption>이어폰 한쪽, 아직 비어 있음</span>
	</p>
</div>

<script>
	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function playDevice(el: HTMLElement): void {
		const revealId = el.dataset.revealTarget;
		const revealEl = revealId ? document.getElementById(revealId) : null;
		const timeEl = el.querySelector<HTMLElement>('[data-time]');
		const statusEl = el.querySelector<HTMLElement>('[data-status]');

		if (prefersReduced) {
			el.classList.add('y04-playing');
			if (timeEl) timeEl.textContent = '00:12';
			if (statusEl) statusEl.textContent = 'PLAY';
			revealEl?.classList.add('y04-show');
			return;
		}

		el.classList.add('y04-playing');
		if (statusEl) statusEl.textContent = 'PLAY';

		let seconds = 0;
		const tick = setInterval(() => {
			seconds += 1;
			if (timeEl) {
				const m = String(Math.floor(seconds / 60)).padStart(2, '0');
				const s = String(seconds % 60).padStart(2, '0');
				timeEl.textContent = `${m}:${s}`;
			}
			if (seconds >= 12) clearInterval(tick);
		}, 1000);

		setTimeout(() => revealEl?.classList.add('y04-show'), 1600);
	}

	const elements = document.querySelectorAll<HTMLElement>('.y04-mp3[data-reveal-target]');
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				playDevice(entry.target as HTMLElement);
				observer.unobserve(entry.target);
			});
		},
		{ threshold: 0.35 }
	);
	elements.forEach((el) => observer.observe(el));
</script>

<style>
	.y04-mp3 {
		margin: 0 auto;
		max-width: 28rem;
	}

	/* 바디 재질 색은 테마와 무관하게 고정 — 브러시드 메탈이라는 물건감 유지 */
	.y04-mp3-body {
		position: relative;
		padding: 1.3rem 1.3rem 1.5rem;
		border-radius: 1.1rem;
		background:
			repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.05) 0px, rgba(255, 255, 255, 0.05) 1px, transparent 1px, transparent 3px),
			linear-gradient(155deg, #cfd3d8, #9aa0a8 55%, #7c828a);
		border: 1.5px solid #5c6169;
		box-shadow: 0 1.1rem 2.5rem rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
	}

	.y04-mp3-screen-bezel {
		padding: 0.55rem;
		border-radius: 0.6rem;
		background: linear-gradient(165deg, #1b1e22, #0a0b0d);
		box-shadow: inset 0 0.2rem 0.5rem rgba(0, 0, 0, 0.6);
	}

	.y04-mp3-screen {
		position: relative;
		padding: 0.65rem 0.8rem 0.55rem;
		border-radius: 0.35rem;
		background-color: #8caf6e;
		background-image: linear-gradient(175deg, #a9c68b, #8caf6e),
			repeating-linear-gradient(to bottom, rgba(31, 46, 20, 0.06) 0px, rgba(31, 46, 20, 0.06) 1px, transparent 1px, transparent 3px);
		box-shadow: inset 0 0.15rem 0.4rem rgba(0, 0, 0, 0.35);
		overflow: hidden;
	}

	.y04-mp3-screen-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: monospace;
		font-size: 0.6rem;
		color: #20300f;
	}

	/* 통신 신호 — 항상 최대 (실제 통신 기능은 없지만, 당시 개인 단말 UI에
	   흔했던 장식 요소) */
	.y04-mp3-signal {
		display: flex;
		align-items: flex-end;
		gap: 0.1rem;
	}

	.y04-mp3-signal span {
		width: 0.16rem;
		background: #20300f;
	}
	.y04-mp3-signal span:nth-child(1) { height: 0.18rem; }
	.y04-mp3-signal span:nth-child(2) { height: 0.26rem; }
	.y04-mp3-signal span:nth-child(3) { height: 0.34rem; }
	.y04-mp3-signal span:nth-child(4) { height: 0.42rem; }
	.y04-mp3-signal span:nth-child(5) { height: 0.5rem; }

	.y04-mp3-screen-battery {
		display: inline-flex;
		align-items: center;
		width: 0.85rem;
		height: 0.45rem;
		padding: 0.06rem;
		border: 1px solid #20300f;
		border-radius: 0.1rem;
	}

	.y04-mp3-screen-battery span {
		display: block;
		width: 70%;
		height: 100%;
		background: #20300f;
	}

	/* 이퀄라이저 막대 — 재생 전에는 낮게 눌린 채 정지, 재생되면 각기 다른
	   높이로 오르내린다 */
	.y04-mp3-eq {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.22rem;
		height: 1.6rem;
		margin: 0.5rem 0 0.3rem;
	}

	.y04-mp3-eq span {
		width: 0.2rem;
		height: 15%;
		margin: 0;
		background: #20300f;
		opacity: 0.55;
		border-radius: 0.08rem;
		transition: height 0.2s ease;
	}

	.y04-mp3.y04-playing .y04-mp3-eq span {
		animation: y04-eq-bounce 1.1s ease-in-out infinite;
		opacity: 0.85;
	}

	.y04-mp3-eq span:nth-child(1) { animation-delay: 0s; }
	.y04-mp3-eq span:nth-child(2) { animation-delay: 0.12s; }
	.y04-mp3-eq span:nth-child(3) { animation-delay: 0.24s; }
	.y04-mp3-eq span:nth-child(4) { animation-delay: 0.06s; }
	.y04-mp3-eq span:nth-child(5) { animation-delay: 0.3s; }
	.y04-mp3-eq span:nth-child(6) { animation-delay: 0.18s; }
	.y04-mp3-eq span:nth-child(7) { animation-delay: 0.36s; }

	@keyframes y04-eq-bounce {
		0%, 100% { height: 15%; }
		50% { height: 90%; }
	}

	/* 그 시절 mp3처럼 가사가 흐르는 마퀴 스크롤 — 재생 전에는 가운데 정지된
	   채로 보이고, 재생 중일 때만 오른쪽에서 왼쪽으로 흐른다 */
	.y04-mp3-tagline {
		margin: 0.5rem 0 0.6rem;
		overflow: hidden;
		white-space: nowrap;
		text-align: center;
	}

	.y04-mp3-tagline-track {
		display: inline-block;
		font-family: 'DotumChe', '돋움체', Menlo, Consolas, monospace;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.4;
		color: #2c4216;
	}

	.y04-mp3.y04-playing .y04-mp3-tagline-track {
		min-width: 100%;
		padding-left: 100%;
		box-sizing: content-box;
		animation: y04-mp3-lyric-marquee 15s linear infinite;
	}

	@keyframes y04-mp3-lyric-marquee {
		0% { transform: translateX(0); }
		100% { transform: translateX(-100%); }
	}

	.y04-mp3-screen-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: monospace;
		font-size: 0.62rem;
		font-weight: 700;
		color: #20300f;
		letter-spacing: 0.03em;
	}

	.y04-mp3-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 0.9rem;
	}

	.y04-mp3-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		border: 1px solid #5c6169;
		background: linear-gradient(165deg, #eef0f2, #c3c8ce);
		color: #33373c;
		font-size: 0.65rem;
		box-shadow: 0 0.15rem 0.3rem rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.6);
		cursor: default;
	}

	.y04-mp3-btn-prev,
	.y04-mp3-btn-next {
		width: 2.1rem;
		height: 1.8rem;
		border-radius: 0.3rem;
	}

	.y04-mp3-btn-play {
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		font-size: 0.85rem;
	}

	.y04-mp3-spec {
		margin: 0.75rem 0 0;
		text-align: center;
		font-family: monospace;
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		color: #4a4f56;
	}

	.y04-mp3-caption {
		margin: 0.9rem 0 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		font-family: var(--y04-font-display);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.y04-mp3-time {
		font-weight: 700;
		color: var(--sl-color-text-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.y04-mp3.y04-playing .y04-mp3-eq span {
			animation: none;
			height: 60%;
		}
		.y04-mp3.y04-playing .y04-mp3-tagline-track {
			animation: none !important;
			padding-left: 0;
			min-width: 0;
		}
	}
</style>
