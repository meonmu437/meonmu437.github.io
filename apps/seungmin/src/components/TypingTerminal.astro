---
// 대문 페이지의 `ls -la` 타이핑 연출과 같은 방식: 터미널 창에 프롬프트 라인들을
// 한 글자씩 타이핑해서 보여준다. 타이핑이 끝나면 revealTarget으로 지정한
// 엘리먼트의 id에 sm-show 클래스를 붙여 뒤이어 나올 콘텐츠를 페이드인한다.
// 각 줄은 문자열이 아니라 세그먼트 배열이라, 프로필/외형 등 다른 코드
// 섹션과 같은 tok-* 팔레트로 부분부분 색을 입힐 수 있다.
interface Segment {
	text: string;
	cls?: string;
}

interface Props {
	lines: Segment[][];
	revealTarget?: string;
}

const { lines, revealTarget } = Astro.props;
---

<div class="sm-typing" data-lines={JSON.stringify(lines)} data-reveal-target={revealTarget}>
	<div class="sm-typing-body"></div>
</div>

<script>
	interface Segment {
		text: string;
		cls?: string;
	}

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function escapeHtml(text: string): string {
		return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	}

	function lineText(segments: Segment[]): string {
		return segments.map((segment) => segment.text).join('');
	}

	function renderSegments(segments: Segment[], charCount: number): string {
		let remaining = charCount;
		let html = '';
		for (const segment of segments) {
			if (remaining <= 0) break;
			const take = Math.min(segment.text.length, remaining);
			const part = escapeHtml(segment.text.slice(0, take));
			html += segment.cls ? `<span class="${segment.cls}">${part}</span>` : part;
			remaining -= take;
		}
		return html;
	}

	function renderRow(segments: Segment[], charCount: number, withCursor: boolean): string {
		const msgClass = withCursor ? 'sm-typing-msg sm-typing-cursor' : 'sm-typing-msg';
		return `<p class="sm-typing-row"><span class="sm-typing-prompt">❯</span><span class="${msgClass}">${renderSegments(segments, charCount)}</span></p>`;
	}

	function typeOut(el: HTMLElement): void {
		const lines: Segment[][] = JSON.parse(el.dataset.lines || '[]');
		const body = el.querySelector<HTMLElement>('.sm-typing-body');
		const revealId = el.dataset.revealTarget;
		const revealEl = revealId ? document.getElementById(revealId) : null;

		function finish(): void {
			el.classList.add('sm-typing-done');
			revealEl?.classList.add('sm-show');
		}

		if (!body) return;

		if (prefersReduced) {
			body.innerHTML = lines
				.map((segments, i) => renderRow(segments, lineText(segments).length, i === lines.length - 1))
				.join('');
			finish();
			return;
		}

		let lineIndex = 0;
		let charIndex = 0;
		const speed = 28;
		const linePause = 350;

		function step(): void {
			if (lineIndex >= lines.length) {
				finish();
				return;
			}
			const doneRows = lines
				.slice(0, lineIndex)
				.map((segments) => renderRow(segments, lineText(segments).length, false))
				.join('');
			const currentSegments = lines[lineIndex];
			const currentText = lineText(currentSegments);
			body.innerHTML = doneRows + renderRow(currentSegments, charIndex, true);

			if (charIndex >= currentText.length) {
				lineIndex++;
				charIndex = 0;
				setTimeout(step, linePause);
			} else {
				charIndex++;
				setTimeout(step, speed);
			}
		}

		step();
	}

	const elements = document.querySelectorAll<HTMLElement>('.sm-typing[data-lines]');
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				typeOut(entry.target as HTMLElement);
				observer.unobserve(entry.target);
			});
		},
		{ threshold: 0.35 }
	);
	elements.forEach((el) => observer.observe(el));
</script>

<style>
	.sm-typing {
		margin: 0 auto;
		max-width: 34rem;
	}

	.sm-typing-body {
		min-height: 5.5rem;
		font-family: var(--sm-font-display);
		font-size: var(--sl-text-sm);
		line-height: 1.9;
	}

	.sm-typing-row {
		margin: 0;
		white-space: pre-wrap;
		word-break: break-word;
	}

	/* 프롬프트 기호: 타이핑되는 메시지와는 다르게, 항상 그대로 보이는 터미널 프롬프트 느낌 */
	.sm-typing-prompt {
		display: inline-block;
		margin-inline-end: 0.6em;
		color: var(--sl-color-accent);
		font-weight: 700;
	}

	.sm-typing-msg {
		color: var(--sm-code-fg);
	}

	/* 타이핑이 끝난 뒤에도 마지막 글자 뒤 커서는 계속 깜빡인다 */
	.sm-typing-cursor::after {
		content: '_';
		margin-inline-start: 0.1em;
		color: var(--sl-color-accent);
		animation: sm-blink 1s step-end infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.sm-typing-cursor::after {
			animation: none;
		}
	}
</style>
