---
// 페이지 맨 아래에서 맨 위로 스크롤하는 버튼. 스크립트/스타일만 있는 컴포넌트.
---

<button type="button" id="sm-back-to-top" class="sm-back-to-top" aria-label="맨 위로">
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="1.1rem" height="1.1rem">
		<path d="M12 19V5" />
		<path d="M5 12l7-7 7 7" />
	</svg>
</button>

<style>
	.sm-back-to-top {
		position: fixed;
		right: clamp(1rem, 4vw, 2rem);
		bottom: clamp(1rem, 4vw, 2rem);
		z-index: var(--sl-z-index-navbar);
		width: 2.75rem;
		height: 2.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 50%;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-text-accent);
		box-shadow: var(--sl-shadow-md);
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.5rem);
		transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
	}

	.sm-back-to-top.sm-visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.sm-back-to-top:hover {
		border-color: var(--sl-color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.sm-back-to-top {
			transition: none;
		}
	}
</style>

<script>
	const button = document.getElementById('sm-back-to-top');
	if (button) {
		const toggleVisible = () => {
			button.classList.toggle('sm-visible', window.scrollY > window.innerHeight * 0.6);
		};
		toggleVisible();
		window.addEventListener('scroll', toggleVisible, { passive: true });

		button.addEventListener('click', () => {
			const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
		});
	}
</script>
